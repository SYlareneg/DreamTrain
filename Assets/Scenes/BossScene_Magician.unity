--- !u!114 &1148012254
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1148012252}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a660c92306a476145abe789c60fd9126, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MagicianEffectManager
  lighting: {fileID: 1195306225}
  spotLight: {fileID: 441296969}
  player: {fileID: 2073807432}
  playerStartPos_notClear: {x: 0, y: -4, z: 0}
  playerStartPos_clear: {x: 0, y: 16.1, z: 0}
  mainCamera: {fileID: 664629956}
  mainCameraStartPos_notClear: {x: 0, y: 6, z: -10}
  mainCameraStartPos_clear: {x: 0, y: 4, z: -10}
  mainCameraEffectPosition: {x: 0, y: 22, z: -10}
  objects: {fileID: 2084934351}
  curtain_closed: {fileID: 2041470191}
  curtain_open: {fileID: 945886845}
  fogs:
  - {fileID: 1341675518}
  - {fileID: 1822587979}
  stageLights:
  - {fileID: 1845670070}
  - {fileID: 1217128982}
  magician_alive: {fileID: 80740185}
  magician_dead: {fileID: 2100936662}
  magicianEffectDialogueLines:
  - speakerName: "\uB9C8\uC220\uC0AC"
    text: "\uC544\uC544... \uBB34\uB300 \uC704\uB85C \uC190\uB2D8\uC774 \uC62C\uB77C\uC628
      \uAC83\uC740 \uC815\uB9D0 \uC624\uB79C\uB9CC\uC785\uB2C8\uB2E4."
    speakerSprite: {fileID: 0}
    sound: {fileID: 0}
  - speakerName: "\uC568\uB9AC\uC2A4"
    text: "\uB204\uAD6C...?"
    speakerSprite: {fileID: 0}
    sound: {fileID: 0}
  - speakerName: "\uB9C8\uC220\uC0AC"
    text: "\uC800\uB294 \uC774 \uB180\uC774\uACF5\uC6D0\uC758 \uC720\uC77C\uD55C
      \uB9C8\uC220\uC0AC."
    speakerSprite: {fileID: 0}
    sound: {fileID: 0}
  - speakerName: "\uB9C8\uC220\uC0AC"
    text: "\uADF8\uB9AC\uACE0 \uB2F9\uC2E0\uC740 \uC774\uACF3\uC758 \uC720\uC77C\uD55C
      \uC190\uB2D8\uC774\uC9C0\uC694."
    speakerSprite: {fileID: 0}
    sound: {fileID: 0}
  - speakerName: "\uC568\uB9AC\uC2A4"
    text: "\uC190\uB2D8\uC774\uB77C\uBA74 \uC800 \uB9D0\uACE0\uB3C4 \uB9CE\uC774
      \uC788\uB294 \uAC78\uC694."
    speakerSprite: {fileID: 0}
    sound: {fileID: 0}
  - speakerName: "\uB9C8\uC220\uC0AC"
    text: "\uC544\uB2C8, \uC800\uB4E4\uC740 \uC190\uB2D8\uC774 \uC544\uB2D9\uB2C8\uB2E4.
      \uC800\uB4E4\uC740 \uAE30\uB300\uD558\uB294 \uBC95\uB3C4, \uC2E4\uB9DD\uD558\uB294
      \uBC95\uB3C4 \uC804\uBD80 \uC78A\uC5C8\uC73C\uB2C8\uAE4C."
    speakerSprite: {fileID: 0}
    sound: {fileID: 0}
  - speakerName: "\uC9C0\uC9C0"
    text: "\uC568\uB9AC\uC2A4, \uB05D\uC790\uB77D\uC5D0 \uAC00\uB824\uBA74 \uBB34\uB300\uC758
      \uB4B7\uD3B8\uC744 \uD1B5\uACFC\uD574\uC57C\uB9CC \uD574."
    speakerSprite: {fileID: -6885921731126323413, guid: 16b48c31bb848aa49b7b59b1d78012db, type: 3}
    sound: {fileID: 8300000, guid: e2386e4b7fd39ef4c8ce8e3fb27a5fc8, type: 3}
  - speakerName: "\uC9C0\uC9C0"
    text: "\uC900\uBE44\uD558\uB294\uAC8C \uC88B\uACA0\uC5B4."
    speakerSprite: {fileID: -6885921731126323413, guid: 16b48c31bb848aa49b7b59b1d78012db, type: 3}
    sound: {fileID: 0}
  - speakerName: "\uB9C8\uC220\uC0AC"
    text: "\uD6C4\uD6C4, \uB2F9\uC2E0\uC744 \uAE30\uB2E4\uB9AC\uB294\uAC8C \uD658\uD76C\uC77C\uC9C0
      \uC808\uB9DD\uC77C\uC9C0. \uC0C1\uC790\uB97C \uC5F4\uC5B4\uBCFC \uC2DC\uAC04\uC774\uAD70\uC694."
    speakerSprite: {fileID: 0}
    sound: {fileID: 0}
  - speakerName: "\uB9C8\uC220\uC0AC"
    text: "\uADF8\uB7FC \uC1FC\uB97C \uC2DC\uC791\uD558\uACA0\uC2B5\uB2C8\uB2E4!"
    speakerSprite: {fileID: 0}
    sound: {fileID: 0}
