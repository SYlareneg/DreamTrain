%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dc705c8908c15b8429ad57f7a0120531, type: 3}
  m_Name: RoomObjectSO
  m_EditorClassIdentifier: Assembly-CSharp::RoomObjectSO
  roomObjects:
  - objectName: "\uACE0\uC591\uC774"
    objectSprite: {fileID: 21300000, guid: 6680d145fb4545d4195fb19b03f500d6, type: 3}
    objectStates:
    - stateName: default
      dialogueLines:
      - speakerName: 
        text: "\uAC80\uC740 \uACE0\uC591\uC774\uB2E4. \uC6B8\uC74C\uC18C\uB9AC\uAC00
          \uC660\uC9C0 \uBAA8\uB974\uAC8C \uC775\uC219\uD558\uB2E4."
        speakerSprite: {fileID: 0}
        sound: {fileID: 0}
    - stateName: awake
      dialogueLines:
      - speakerName: "\uC9C0\uC9C0"
        text: "\uC568\uB9AC\uC2A4, \uB4DC\uB514\uC5B4 \uC900\uBE44\uAC00 \uB410\uC5B4?"
        speakerSprite: {fileID: -6885921731126323413, guid: 16b48c31bb848aa49b7b59b1d78012db, type: 3}
        sound: {fileID: 0}
      - speakerName: "\uC568\uB9AC\uC2A4"
        text: ...?
        speakerSprite: {fileID: 0}
        sound: {fileID: 0}
      - speakerName: "\uC9C0\uC9C0"
        text: "\uC124\uB9C8 \uC78A\uC740 \uAC74 \uC544\uB2C8\uC9C0? \uC624\uB298
          \uBB38 \uBC16\uC73C\uB85C \uB098\uAC00\uAE30\uB85C \uD588\uC796\uC544!"
        speakerSprite: {fileID: -6885921731126323413, guid: 16b48c31bb848aa49b7b59b1d78012db, type: 3}
        sound: {fileID: 0}
      - speakerName: "\uC568\uB9AC\uC2A4"
        text: " \u2026\uD558\uC9C0\uB9CC \uC5EC\uAE30\uC5D4 \uC774\uC81C \uBB38\uC774
          \uC5C6\uB294\uAC78."
        speakerSprite: {fileID: 0}
        sound: {fileID: 0}
      - speakerName: "\uC9C0\uC9C0"
        text: "\uAC70\uC6B8 \uC548\uC73C\uB85C \uB4E4\uC5B4\uAC00\uBA74 \uB418\uB294\uB370
          \uBB34\uC2A8 \uAC71\uC815\uC774\uC57C?"
        speakerSprite: {fileID: -6885921731126323413, guid: 16b48c31bb848aa49b7b59b1d78012db, type: 3}
        sound: {fileID: 0}
      - speakerName: "\uC568\uB9AC\uC2A4"
        text: "\uAC70\uC6B8 \uC548\uC73C\uB85C?"
        speakerSprite: {fileID: 0}
        sound: {fileID: 0}
      - speakerName: "\uC9C0\uC9C0"
        text: "\uC790, \uC774\uC81C \uCD9C\uBC1C\uD558\uC790\uACE0! \uBE68\uB9AC
          \uAC70\uC6B8 \uC55E\uC5D0 \uAC00\uBD10!"
        speakerSprite: {fileID: -6885921731126323413, guid: 16b48c31bb848aa49b7b59b1d78012db, type: 3}
        sound: {fileID: 0}
    - stateName: tutorial
      dialogueLines:
      - speakerName: "\uC9C0\uC9C0"
        text: "\uC568\uB9AC\uC2A4, \uB4DC\uB514\uC5B4 \uC900\uBE44\uAC00 \uB410\uC5B4?"
        speakerSprite: {fileID: -6885921731126323413, guid: 16b48c31bb848aa49b7b59b1d78012db, type: 3}
        sound: {fileID: 0}
      - speakerName: "\uC568\uB9AC\uC2A4"
        text: ...?
        speakerSprite: {fileID: 0}
        sound: {fileID: 0}
      - speakerName: "\uC9C0\uC9C0"
        text: "\uC124\uB9C8 \uC78A\uC740 \uAC74 \uC544\uB2C8\uC9C0? \uC624\uB298
          \uBB38 \uBC16\uC73C\uB85C \uB098\uAC00\uAE30\uB85C \uD588\uC796\uC544!"
        speakerSprite: {fileID: -6885921731126323413, guid: 16b48c31bb848aa49b7b59b1d78012db, type: 3}
        sound: {fileID: 0}
      - speakerName: "\uC568\uB9AC\uC2A4"
        text: "...\uBB38?"
        speakerSprite: {fileID: 0}
        sound: {fileID: 0}
      - speakerName: "\uC9C0\uC9C0"
        text: "\uC774\uB7F0, \uC815\uB9D0 \uBAA8\uB450 \uC78A\uC5B4\uBC84\uB838\uB098\uBCF4\uB124..."
        speakerSprite: {fileID: -6885921731126323413, guid: 16b48c31bb848aa49b7b59b1d78012db, type: 3}
        sound: {fileID: 0}
      - speakerName: "\uC9C0\uC9C0"
        text: "\uC5B4\uCA54 \uC218 \uC5C6\uC9C0. \uADF8\uB7FC \uC774\uACF3\uC5D0
          \uB300\uD574 \uAC04\uB2E8\uD788 \uC54C\uB824\uC8FC\uB3C4\uB85D \uD560\uAC8C."
        speakerSprite: {fileID: -6885921731126323413, guid: 16b48c31bb848aa49b7b59b1d78012db, type: 3}
        sound: {fileID: 0}
      - speakerName: 
        text: "(\uC9C0\uC9C0\uAC00 \uC54C \uC218 \uC5C6\uB294 \uD798\uC744 \uC0AC\uC6A9\uD558\uACE0
          \uC788\uB2E4.)"
        speakerSprite: {fileID: 0}
        sound: {fileID: 0}
      - speakerName: "\uC568\uB9AC\uC2A4"
        text: "\uC7A0\uAE50, \uB09C \uC544\uC9C1 \uC900\uBE44\uAC00...!"
        speakerSprite: {fileID: 0}
        sound: {fileID: 0}
      - speakerName: "\uC9C0\uC9C0"
        text: "\uAC71\uC815 \uB9C8. \uC774\uAC74 \uADF8\uC800 '\uD29C\uD1A0\uB9AC\uC5BC'\uC77C
          \uBFD0\uC774\uB2C8\uAE4C."
        speakerSprite: {fileID: -6885921731126323413, guid: 16b48c31bb848aa49b7b59b1d78012db, type: 3}
        sound: {fileID: 0}
      - speakerName: 
        text: "\uD29C\uD1A0\uB9AC\uC5BC\uC744 \uC2DC\uC791\uD569\uB2C8\uB2E4."
        speakerSprite: {fileID: 0}
        sound: {fileID: 0}
  - objectName: "\uAC70\uC6B8"
    objectSprite: {fileID: 21300000, guid: ac3f87493b2a36945b3dbe98aedd1e64, type: 3}
    objectStates: []
  - objectName: "\uBCBD\uB09C\uB85C"
    objectSprite: {fileID: 21300000, guid: fc5211cd84e8ce9449c8fcfa6098b325, type: 3}
    objectStates:
    - stateName: default
      dialogueLines:
      - speakerName: 
        text: "\uBCBD\uB09C\uB85C\uC5D0 \uC190\uC744 \uB123\uC5C8\uB2E4."
        speakerSprite: {fileID: 0}
        sound: {fileID: 0}
      - speakerName: 
        text: "\uBB34\uC5B8\uAC00 \uD0C0\uB294 \uB0C4\uC0C8\uAC00 \uB09C\uB2E4. \uB530\uB73B\uD558\uB2E4."
        speakerSprite: {fileID: 0}
        sound: {fileID: 0}
  - objectName: "\uC2DC\uACC4"
    objectSprite: {fileID: 21300000, guid: fc5211cd84e8ce9449c8fcfa6098b325, type: 3}
    objectStates:
    - stateName: default
      dialogueLines:
      - speakerName: 
        text: "\uC2DC\uACC4\uBC14\uB298\uC740 \uC6C0\uC9C1\uC774\uC9C0 \uC54A\uC9C0\uB9CC,
          \uBD84\uBA85\uD788 \uC9F8\uAE4D\uAC70\uB9AC\uB294 \uC18C\uB9AC\uAC00 \uB4E4\uB9B0\uB2E4."
        speakerSprite: {fileID: 0}
        sound: {fileID: 0}
  - objectName: "\uCE68\uB300"
    objectSprite: {fileID: 21300000, guid: fc5211cd84e8ce9449c8fcfa6098b325, type: 3}
    objectStates:
    - stateName: default
      dialogueLines:
      - speakerName: 
        text: "\uC9C0\uAE08 \uC7A0\uC5D0 \uB4E4\uBA74 \uC601\uC6D0\uD788 \uC798 \uC218
          \uC788\uC744 \uAC83\uB9CC \uAC19\uB2E4..."
        speakerSprite: {fileID: 0}
        sound: {fileID: 0}
  - objectName: "\uBE57\uC790\uB8E8"
    objectSprite: {fileID: 21300000, guid: fc5211cd84e8ce9449c8fcfa6098b325, type: 3}
    objectStates:
    - stateName: default
      dialogueLines:
      - speakerName: 
        text: "\uB108\uBB34 \uBB34\uAC70\uC6CC\uC11C \uB4E4 \uC218\uAC00 \uC5C6\uB2E4."
        speakerSprite: {fileID: 0}
        sound: {fileID: 0}
