  dreamPieces:
  - name: "\uBC40\uD30C\uC774\uC5B4\uC758 \uAFC8"
    persona:
      type: 1
      dreamPieceNum: 0
      sprite: 
      name: "\uBD89\uC740 \uB2EC"
      text: "\uCCB4\uB825\uC744 \uD68C\uBCF5\uD560 \uB54C\uB9C8\uB2E4 \uD2B8\uB9AC\uAC70
        \uAC8C\uC774\uC9C0\uB97C \uC5BB\uC2B5\uB2C8\uB2E4.\\n \uD2B8\uB9AC\uAC70
        \uD6A8\uACFC: \uD604\uC7AC \uCCB4\uB825\uC758 10%\uB97C \uC18C\uBAA8\uD569\uB2C8\uB2E4.
        \uC18C\uBAA8\uD55C \uCCB4\uB825\uC758 3\uBC30\uB9CC\uD07C \uC801\uC5D0\uAC8C
        \uD53C\uD574\uB97C \uC90D\uB2C8\uB2E4."
      name_enhanced: "\uBD89\uC740 \uB2EC+"
      text_enhanced: "\uCCB4\uB825\uC744 \uD68C\uBCF5\uD560 \uB54C\uB9C8\uB2E4 \uD2B8\uB9AC\uAC70
        \uAC8C\uC774\uC9C0\uB97C \uC5BB\uC2B5\uB2C8\uB2E4.\\n \uD2B8\uB9AC\uAC70
        \uD6A8\uACFC: \uD604\uC7AC \uCCB4\uB825\uC758 10%\uB97C \uC18C\uBAA8\uD569\uB2C8\uB2E4.
        \uC18C\uBAA8\uD55C \uCCB4\uB825\uC758 <color=red>4\uBC30</color>\uB9CC\uD07C
        \uC801\uC5D0\uAC8C \uD53C\uD574\uB97C \uC90D\uB2C8\uB2E4."
    shadow:
      type: 2
      dreamPieceNum: 0
      sprite: 
      name: "\uBD89\uC740 \uC1A1\uACF3\uB2C8"
      text: "\uACF5\uACA9 \uB8F0\uB81B\uC73C\uB85C \uC785\uD78C \uD53C\uD574\uC758
        33%\uB9CC\uD07C \uCCB4\uB825\uC744 \uD68C\uBCF5\uD569\uB2C8\uB2E4. (\uC18C\uC218\uC810
        \uB0B4\uB9BC)"
      name_enhanced: "\uBD89\uC740 \uC1A1\uACF3\uB2C8+"
      text_enhanced: "\uACF5\uACA9 \uB8F0\uB81B\uC73C\uB85C \uC785\uD78C \uD53C\uD574\uC758
        50%\uB9CC\uD07C \uCCB4\uB825\uC744 \uD68C\uBCF5\uD569\uB2C8\uB2E4. (\uC18C\uC218\uC810
        \uB0B4\uB9BC)"
    triggerSprite: Vampire_Trigger
    playerSpecialRoulettes:
