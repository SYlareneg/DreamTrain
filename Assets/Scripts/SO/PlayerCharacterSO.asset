  personaPiece:
    name: "\uB9C8\uC220\uC0AC\uC758 \uAFC8"
    description: 
    courageStat: 0
    wisdomStat: 0
    luckStat: 0
    persona:
      type: 1
      sprite: {fileID: 21300000, guid: e5cef4376a08c004f8320c0bda733ba2, type: 3}
      name: "\uB9C8\uC220 \uD574\uCCB4"
      text: "\uAC8C\uC784 \uC2DC\uC791 \uC2DC \uB371\uC5D0 \uC5D0\uC774\uC2A4 \uCE74\uB4DC\uB97C
        \uD55C \uC7A5 \uCD94\uAC00\uD569\uB2C8\uB2E4. \uC5D0\uC774\uC2A4 \uCE74\uB4DC\uB97C
        \uC0AC\uC6A9\uD558\uC5EC \uD2B8\uB9AC\uAC70\uD569\uB2C8\uB2E4.\n\uD2B8\uB9AC\uAC70
        \uD6A8\uACFC: \uB8F0\uB81B\uC5D0 \uBD80\uC5EC\uB41C \uD6A8\uACFC\uB97C \uBAA8\uB450
        \uC81C\uAC70\uD569\uB2C8\uB2E4.(\uACF5\uACA9, \uC218\uBE44 \uC81C\uC678)
        \uC801\uC5D0\uAC8C \uC81C\uAC70\uD55C \uD6A8\uACFC \uAC1C\uC218*6\uC758 \uD53C\uD574\uB97C
        \uC90D\uB2C8\uB2E4."
      dreamPieceNum: 1
      isEnhanced: 0
      enhancedPassive:
        type: 1
        sprite: {fileID: 21300000, guid: e5cef4376a08c004f8320c0bda733ba2, type: 3}
        name: "\uB9C8\uC220 \uD574\uCCB4+"
        text: "\uAC8C\uC784 \uC2DC\uC791 \uC2DC \uB371\uC5D0 \uC5D0\uC774\uC2A4+
          \uCE74\uB4DC\uB97C \uD55C \uC7A5 \uCD94\uAC00\uD569\uB2C8\uB2E4. \uC5D0\uC774\uC2A4
          \uCE74\uB4DC\uB97C \uC0AC\uC6A9\uD558\uC5EC \uD2B8\uB9AC\uAC70\uD569\uB2C8\uB2E4.\n\uD2B8\uB9AC\uAC70
          \uD6A8\uACFC: \uB8F0\uB81B\uC5D0 \uBD80\uC5EC\uB41C \uD6A8\uACFC\uB97C
          \uBAA8\uB450 \uC81C\uAC70\uD569\uB2C8\uB2E4.(\uACF5\uACA9, \uC218\uBE44
          \uC81C\uC678) \uC801\uC5D0\uAC8C \uC81C\uAC70\uD55C \uD6A8\uACFC \uAC1C\uC218*6\uC758
          \uD53C\uD574\uB97C \uC90D\uB2C8\uB2E4. 6\uAC1C \uC774\uC0C1\uC758 \uD6A8\uACFC\uB97C
          \uC81C\uAC70\uD558\uB294 \uACBD\uC6B0 150% \uD53C\uD574\uB97C \uC90D\uB2C8\uB2E4 "
        dreamPieceNum: 1
    shadow:
      type: 2
      sprite: {fileID: 21300000, guid: e5cef4376a08c004f8320c0bda733ba2, type: 3}
      name: "\uC190\uAE30\uC220"
      text: "\uCE74\uB4DC\uB97C 3\uC7A5 \uC0AC\uC6A9\uD558\uBA74 \uC989\uC2DC \uCE74\uB4DC\uB97C
        1\uC7A5 \uB4DC\uB85C\uC6B0\uD569\uB2C8\uB2E4."
      dreamPieceNum: 1
