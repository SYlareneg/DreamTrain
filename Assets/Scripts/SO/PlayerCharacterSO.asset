  personaPiece:
    name: "\uACE0\uC591\uC774\uC758 \uAFC8"
    description: "\uAC80\uACE0 \uADC0\uC5EC\uC6B4 \uACE0\uC591\uC774\uC785\uB2C8\uB2E4.
      \uB0A0\uCE74\uB85C\uC6B4 \uBC1C\uD1B1\uACFC \uBBFC\uCCA9\uD55C \uBAB8\uB180\uB9BC\uC73C\uB85C
      \uC704\uD5D8\uC744 \uB3CC\uD30C\uD569\uB2C8\uB2E4."
    courageStat: 0
    wisdomStat: 0
    luckStat: 1
    persona:
      type: 1
      sprite: {fileID: -6690263383312596796, guid: d7a16495d63463f46b9d7629cceaf3ee, type: 3}
      name: "\uC0AC\uB0E5 \uBCF8\uB2A5"
      text: "\uCE74\uB4DC\uB97C \uC0AC\uC6A9\uD560 \uB54C\uB9C8\uB2E4 \uD2B8\uB9AC\uAC70\uB97C
        1  \uC5BB\uC2B5\uB2C8\uB2E4.\n\uD2B8\uB9AC\uAC70 \uD6A8\uACFC: \uBAA8\uB4E0
        \uC801\uC5D0\uAC8C 24\uC758 \uB370\uBBF8\uC9C0\uB97C \uC90D\uB2C8\uB2E4."
      dreamPieceNum: 3
      isEnhanced: 0
      enhancedPassive:
        type: 1
        sprite: {fileID: -6690263383312596796, guid: d7a16495d63463f46b9d7629cceaf3ee, type: 3}
        name: "\uC0AC\uB0E5 \uBCF8\uB2A5+"
        text: "\uCE74\uB4DC\uB97C \uC0AC\uC6A9\uD560 \uB54C\uB9C8\uB2E4 \uD2B8\uB9AC\uAC70\uB97C
          1  \uC5BB\uC2B5\uB2C8\uB2E4.\n\uD2B8\uB9AC\uAC70 \uD6A8\uACFC: \uBAA8\uB4E0
          \uC801\uC5D0\uAC8C <color=red>33</color>\uC758 \uB370\uBBF8\uC9C0\uB97C
          \uC90D\uB2C8\uB2E4."
