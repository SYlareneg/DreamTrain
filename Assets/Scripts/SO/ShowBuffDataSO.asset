  - name: "\uBCF4\uD638"
    text: "\uD68D\uB4DD\uD558\uB294 \uBC29\uC5B4\uB3C4\uAC00 \uAC12\uB9CC\uD07C \uC99D\uAC00\uD569\uB2C8\uB2E4."
    icon: 
    type: 0
    effectType: 2
    defaultVal:
    - 1
  - name: "\uD65C\uB825"
    text: "\uCCB4\uB825 \uD68C\uBCF5\uB7C9\uC774 \uAC12\uB9CC\uD07C \uC99D\uAC00\uD569\uB2C8\uB2E4."
    icon: 
    type: 0
    effectType: 2
    defaultVal:
    - 1
  - name: "\uC8FC\uC800\uD568"
    text: "\uACF5\uACA9\uC758 \uD53C\uD574\uB7C9\uC774 25% \uAC10\uC18C\uD569\uB2C8\uB2E4.
      \uC9C0\uC18D \uD134\uC218: \uAC12\uD134"
    icon: 
    type: 1
    effectType: 1
    defaultVal:
    - 0.75
  - name: "\uCDE8\uC57D"
    text: "\uBC1B\uB294 \uBAA8\uB4E0 \uD53C\uD574\uB7C9\uC774 50% \uC99D\uAC00\uD569\uB2C8\uB2E4.
      \uC9C0\uC18D \uD134\uC218: \uAC12\uD134"
    icon: 
    type: 1
    effectType: 1
    defaultVal:
    - 1.5
  - name: "\uBE14\uB8E8 \uBE14\uB7EC\uB4DC"
    text: "\uD50C\uB808\uC774\uC5B4\uAC00 \uBD80\uC5EC\uD55C \uD761\uD608 \uB8F0\uB81B\uC774
      \uCCB4\uB825\uC744 \uD68C\uBCF5\uC2DC\uD0A4\uC9C0 \uC54A\uC9C0\uB9CC, 3\uBC30\uC758
      \uB370\uBBF8\uC9C0\uB97C \uC90D\uB2C8\uB2E4. \uC9C0\uC18D \uD134\uC218: \uAC12\uD134"
    icon: 
    type: 1
    effectType: 0
    defaultVal:
    - 3
    - 0
  - name: "\uB9CC\uCC2C \uC2DC\uAC04"
    text: "\uD50C\uB808\uC774\uC5B4\uAC00 \uBD80\uC5EC\uD55C \uD761\uD608 \uB8F0\uB81B\uC774
      2\uBC30\uC758 \uB370\uBBF8\uC9C0\uB97C \uC90D\uB2C8\uB2E4. \uC9C0\uC18D \uD134\uC218:
      \uAC12\uD134"
    icon: 
    type: 1
    effectType: 0
    defaultVal:
    - 2
  - name: "\uC608\uC5B8-\uC900\uBE44"
    text: "\uB2E4\uC74C \uD134\uC5D0 \uC608\uC5B8 \uBC84\uD504\uB97C \uC5BB\uC2B5\uB2C8\uB2E4.
      \uC9C0\uC18D \uD134\uC218: \uAC12\uD134"
    icon: 
    type: 1
    effectType: 0
    defaultVal: []
  - name: "\uC608\uC5B8"
    text: "\uD2B8\uB9AC\uAC70\uD558\uBA74 \uD589\uB3D9\uB825\uC744 \uC989\uC2DC \uCD5C\uB300\uB85C
      \uD68C\uBCF5\uD569\uB2C8\uB2E4. \uC9C0\uC18D \uD134\uC218: \uAC12\uD134"
    icon: 
    type: 1
    effectType: 0
    defaultVal: []
  - name: "\uD658\uC601"
    text: "\uBC1B\uB294 \uD53C\uD574\uB97C 0\uC73C\uB85C \uB9CC\uB4ED\uB2C8\uB2E4.
      \uD6A8\uACFC \uBC1C\uB3D9 \uC2DC \uD69F\uC218\uB97C \uC18C\uBAA8\uD569\uB2C8\uB2E4.
      \uB0A8\uC740 \uD69F\uC218: \uAC12"
    icon: 
    type: 2
    effectType: 0
    defaultVal: []
  - name: "\uACFC\uBBFC\uD568"
    text: "\uBC1B\uB294 \uD53C\uD574\uAC00 50% \uC99D\uAC00\uD569\uB2C8\uB2E4. \uD6A8\uACFC
      \uBC1C\uB3D9 \uC2DC \uD69F\uC218\uAC00 \uC904\uC5B4\uB4ED\uB2C8\uB2E4. \uB0A8\uC740
      \uD69F\uC218: \uAC12"
    icon: 
    type: 2
    effectType: 1
    defaultVal:
    - 1.5
  - name: "\uBD88\uCF8C\uD568"
    text: "\uB8F0\uB81B \uD68C\uC804 \uC2DC 3\uC758 \uD53C\uD574\uB97C \uC785\uC2B5\uB2C8\uB2E4.
      \uD6A8\uACFC \uBC1C\uB3D9 \uC2DC \uD69F\uC218\uAC00 \uC904\uC5B4\uB4ED\uB2C8\uB2E4.
      \uB0A8\uC740 \uD69F\uC218: \uAC12"
    icon: 
    type: 2
    effectType: 1
    defaultVal:
    - 3
  - name: "\uD68C\uC804 \uBD09\uC778"
    text: "\uB8F0\uB81B\uC744 \uD68C\uC804\uC2DC\uD0AC \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.\\n\uC9C0\uC18D\uD134\uC218:
      \uAC12\uD134"
    icon: 
    type: 1
    effectType: 1
    defaultVal: []
  - name: "\uB180\uC774 \uC2DC\uAC04"
    text: "\uD68C\uC804 \uCE74\uB4DC\uB97C \uC0AC\uC6A9\uD560 \uB54C\uB9C8\uB2E4
      \uD589\uB3D9\uB825\uC744 1 \uC5BB\uC2B5\uB2C8\uB2E4.\\n\uC9C0\uC18D \uD134
      \uC218: \uAC12\uD134"
    icon: 
    type: 1
    effectType: 0
    defaultVal:
    - 1
  - name: "\uBE59\uADF8\uB974!"
    text: "\uB8F0\uB81B\uC774 3\uCE78 \uC774\uC0C1 \uD68C\uC804\uD558\uBA74 \uAC15\uD654\uB97C
      1 \uC5BB\uC2B5\uB2C8\uB2E4. \uD6A8\uACFC \uBC1C\uB3D9\uC2DC \uD69F\uC218\uAC00
      \uC904\uC5B4\uB4E4\uBA70, \uD69F\uC218\uAC00 0\uC774 \uB418\uBA74 \uC4F0\uB7EC\uC9D1\uB2C8\uB2E4."
