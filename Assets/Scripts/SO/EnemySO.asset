    enemySpecialActions:
    - sprite: {fileID: -1521565114957691944, guid: b8b8956a5637e7f49819dc7206e06c9a, type: 3}
      title: "\uB9C8\uC220-\uBD88\uAF43"
      text: "\uD134x2+\uB9C8\uC220 \uBAA8\uC790 \uAC1C\uC218x5 \uC758 \uD53C\uD574\uB97C
        \uC90D\uB2C8\uB2E4. \uB9C8\uC220 \uBAA8\uC790\uAC00 \uD558\uB098\uB3C4 \uC5C6\uB2E4\uBA74
        \uB9C8\uC220\uC5D0 \uC2E4\uD328\uD569\uB2C8\uB2E4."
    - sprite: {fileID: -1521565114957691944, guid: b8b8956a5637e7f49819dc7206e06c9a, type: 3}
      title: "\uB9C8\uC220-\uD658\uC601"
      text: "\uB9C8\uC220 \uBAA8\uC790 1\uAC1C\uB2F9 1\uC758 \uD658\uC601 \uBC84\uD504\uB97C
        \uC5BB\uC2B5\uB2C8\uB2E4. \uB9C8\uC220 \uBAA8\uC790\uAC00 \uD558\uB098\uB3C4
        \uC5C6\uB2E4\uBA74 \uB9C8\uC220\uC5D0 \uC2E4\uD328\uD569\uB2C8\uB2E4."
    - sprite: {fileID: -1521565114957691944, guid: b8b8956a5637e7f49819dc7206e06c9a, type: 3}
      title: "\uB9C8\uC220 \uC900\uBE44-\uC1FC\uD0C0\uC784"
      text: "\uACF5\uACA9, \uC218\uBE44 \uB8F0\uB81B\uC744 \uC81C\uC678\uD55C \uBAA8\uB4E0
        \uB8F0\uB81B\uC5D0 \uB9C8\uC220 \uBAA8\uC790\uB97C \uBD80\uC5EC\uD569\uB2C8\uB2E4."
    - sprite: {fileID: -1521565114957691944, guid: b8b8956a5637e7f49819dc7206e06c9a, type: 3}
      title: "\uB9C8\uC220-\uC1FC\uD0C0\uC784"
      text: "\uD134x1+\uB9C8\uC220 \uBAA8\uC790 \uAC1C\uC218x1 \uC758 \uD53C\uD574\uB97C
        \uC90D\uB2C8\uB2E4."
