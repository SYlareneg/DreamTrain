      name: "\uD761\uD608 \uBCF8\uB2A5"
      text: "\uD50C\uB808\uC774\uC5B4\uC5D0\uAC8C \uC801\uC911 \uC2DC \uD761\uD608\uC744
        3\uBC88 \uC5F0\uC18D \uC2E4\uD589\uD558\uACE0 \uBE44\uD65C\uC131\uD654\uB429\uB2C8\uB2E4."
      dreamPieceNum: 0
    relics: []
    triggerNum: 2
    phase:
    - name: "\uBE48\uD608"
      text: "\uD53C\uAC00 \uBD80\uC871\uD55C \uC0C1\uD0DC\uC785\uB2C8\uB2E4. \uD761\uD608\uB85C
        \uCCB4\uB825\uC744 2\uBC88 \uD68C\uBCF5\uD558\uBA74 '\uAC01\uC131:\uBC40\uD30C\uC774\uC5B4'
        \uD328\uD134\uC73C\uB85C \uC804\uD658\uD569\uB2C8\uB2E4."
      patterns:
      - pattern:
        - type: 0
