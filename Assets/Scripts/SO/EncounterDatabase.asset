  - id: ACT1_WINE_IN_CUP
    nameKO: "\uCC3B\uC794\uACFC \uC640\uC778\uC794"
    type: 0
    imageName: "\uCC3B\uC794\uACFC \uC640\uC778\uC794"
    textPath: 
    order: 0
    isEssential: 0
    sourceCsvFile: {fileID: 0}
    encounterContext:
      csvRawData: "Page_ID,Type,Text_Content,Next_Page_ID,Call_Function,Constraint,\nP1,DESC,\"\uB2F9\uC2E0\uC740
        \uBE59\uAE00\uBE59\uAE00 \uB3C4\uB294 \uCC3B\uC794\uB4E4\uC5D0 \uC549\uC544
        \uC7A0\uAE50 \uC26C\uC5C8\uB2E4\uAC00\uAE30\uB85C \uACB0\uC815\uD569\uB2C8\uB2E4.
        \uADF8\uB7F0\uB370 \uCC3B\uC794\uB4E4 \uC18D\uC5D0 \uCC3B\uC794\uC774 \uC544\uB2CC
        \uB2E4\uB978 \uAC8C \uD558\uB098 \uC11E\uC5EC \uC788\uAD70\uC694. \uC640\uC778\uC794\uC785\uB2C8\uB2E4!\n\"\"\uB098\uB3C4
        \uC5B8\uC820\uAC00\uB294 \uBA4B\uC9C4 \uCC3B\uC794\uC774 \uB420 \uC218 \uC788\uACA0\uC9C0?
        \uB098\uB294 \uC65C \uC774\uB7F0 \uBAA8\uC2B5\uC73C\uB85C \uD0DC\uC5B4\uB09C
        \uAC78\uAE4C.\"\"\n\uADF8 \uB9D0\uC744 \uB4E4\uC740 \uB2E4\uB978 \uCC3B\uC794\uB4E4\uC774
        \uC640\uC778\uC794\uC744 \uBE44\uB09C\uD569\uB2C8\uB2E4.\n\n\"\"\uB9D0\uB3C4
        \uC548 \uB3FC. \uB108\uB294 \uCC3B\uC794\uC774 \uC544\uB2C8\uC57C. \uB108
        \uAC19\uC740 \uCEF5\uC740 \uC5EC\uAE30 \uC788\uC73C\uBA74 \uC548 \uB3FC.\"\"\n\"\"\uC800
        \uB188\uC744 \uAE68\uBC84\uB824\uC57C \uD574!\"\"\n\"\"\uC6B0\uB9AC\uAC00
        \uC190\uB9CC \uC788\uC5C8\uB354\uB77C\uBA74!\"\"\n\n\uCC3B\uC794\uB4E4\uC774
        \uB2F9\uC2E0\uC744 \uBC14\uB77C\uBD05\uB2C8\uB2E4.\n\"\"\uC544\uC774\uC57C,
        \uB124\uAC00 \uB300\uC2E0 \uC800 \uC774\uC0C1\uD55C \uCEF5\uC744 \uD63C\uB0B4\uC8FC\uC9C0
        \uC54A\uC744\uB798? \uB2E4\uC2DC\uB294 \uC790\uAE30\uAC00 \uCC3B\uC794\uC774
        \uB420 \uC218 \uC788\uC744 \uAC70\uB77C\uB294 \uAC74\uBC29\uC9C4 \uC18C\uB9AC\uB97C
        \uD558\uC9C0 \uBABB\uD558\uB3C4\uB85D \uB9D0\uC774\uC57C.\"\"\n\n\",,,\nP1,BRANCH,\"\uC640\uC778\uC794\uC744
        \uD63C\uB0B4\uC900\uB2E4.     (\uC804\uD22C)\n\",P_AFTER_BATTLE,StartBattle(Wine),DEFAULT\nP1,BRANCH,\uAC70\uC808\uD55C\uB2E4.,P_REJECTION,,\nP_AFTER_BATTLE,DESC,\"\"\"\uADF8\uB9CC,
        \uB0B4\uAC00 \uC798\uBABB\uD588\uC5B4! \uC55E\uC73C\uB85C\uB294 \uC870\uC6A9\uD788
        \uC640\uC778\uC73C\uB85C \uC0B4\uC544\uAC08\uD14C\uB2C8 \uADF8\uB9CC \uD574\u2026\"\"\n\uB2F9\uC2E0
        \uC55E\uC5D0 \uC758\uAE30\uC18C\uCE68\uD574\uC9C4 \uC640\uC778\uC794\uC744
        \uB458\uB7EC\uC2F8\uACE0 \uCC3B\uC794\uB4E4\uC774 \uC870\uC18C\uD569\uB2C8\uB2E4.\n\n\"\"\uD6C4\uC6B0!
        \uACE0\uB9C8\uC6CC, \uC544\uC774\uC57C. \uC5EC\uAE30 \uC774\uAC74 \uBCF4\uB2F5\uC774\uC57C!\"\"\n\uB2F9\uC2E0\uC740
        \uCC3B\uC794\uC758 \uC120\uBB3C\uC744 \uBC1B\uC544\uB4E4\uACE0\uB294 \uC790\uB9AC\uB97C
        \uB5A0\uB0A9\uB2C8\uB2E4. \n\",,GetDebris(1),DEFAULT\nP_AFTER_BATTLE,BRANCH,\uB5A0\uB09C\uB2E4,END,,DEFAULT\nP_REJECTION,DESC,\"\"\"\uADF8\uB798?
        \uB108\uB3C4 \uB098\uC05C \uC544\uC774\uC600\uAD6C\uB098.\"\"\n\"\"\uB098\uC05C
        \uC544\uC774\uB294 \uBC8C\uC744 \uBC1B\uC544\uC57C \uD574.\"\"\n\"\"\uADF8\uB7FC,
        \uADF8\uB7FC. \uBC8C\uC744 \uBC1B\uC544\uC57C \uD574.\"\"\n\n\uBD84\uB178\uD55C
        \uCC3B\uC794\uB4E4\uC774 \uB2F9\uC2E0\uC5D0\uAC8C \uB364\uBCBC\uB4ED\uB2C8\uB2E4.\",,,\nP_REJECTION,BRANCH,\uC800\uD56D\uD55C\uB2E4 
        (\uC804\uD22C),P_AFTER_REJECTION,StartBattle(Cups),DEFAULT\nP_AFTER_REJECTION,DESC,\"\uB2F9\uC2E0\uC740
        \uCC3B\uC794\uB4E4\uC744 \uBA4B\uC9C0\uAC8C \uC81C\uC555\uD588\uC2B5\uB2C8\uB2E4.\n\n\"\"\uC815\uB9D0
        \uB300\uB2E8\uD55C\uB370\u2026\"\"\n\uC640\uC778\uC794\uC740 \uAC10\uD0C4\uD569\uB2C8\uB2E4.\n\"\"\uACB0\uC2EC\uD588\uC5B4.
        \uB09C \uCC3B\uC794\uC774 \uC544\uB2C8\uB77C \uB124\uAC00 \uB420\uB798.\"\"\n\n\uC640\uC778\uC794\uC740
        \uAC10\uACA9\uC758 \uB208\uBB3C\uC744 \uD758\uB9BD\uB2C8\uB2E4. \uB5A8\uC5B4\uC9C4
        \uB208\uBB3C\uC774 \uBC14\uB2E5\uC5D0 \uB2FF\uC544 \uC21C\uC2DD\uAC04\uC5D0
        \uB2E8\uB2E8\uD55C \uACB0\uC815\uC774 \uB418\uC5C8\uC2B5\uB2C8\uB2E4. \n\n\uB2F9\uC2E0\uC740
        \uC640\uC778\uC794\uC758 \uC120\uBB3C\uC744 \uC90D\uACE0 \uC790\uB9AC\uB974
        \uB5A0\uB0A9\uB2C8\uB2E4. \n\n\n\",,,\nP_AFTER_REJECTION,BRANCH,\"\uB5A0\uB09C\uB2E4\n\",END,GetObjet(WineDrop),DEFAULT\n,,,,,\n,,,,,\n"
