  - id: ACT1_BAT_ATTACK
    nameKO: "\uBC15\uC950\uC758 \uC2B5\uACA9"
    type: 0
    imagePath: Bat_Attack
    filePath: Bat_Attack
    order: 1
    isEssential: 0
    constraint: 
    sourceCsvFile: {fileID: 0}
    csvRawData: "Page_ID,Type,Text_Content,Next_Page_ID,Call_Function,Constraint\r\nP1,DESC,\"\uC9D1
      \uB0B4\uBD80 \uC5B4\uB518\uAC00\uC5D0\uC11C \uC2EC\uC0C1\uCE58 \uC54A\uC740
      \uC18C\uB9AC\uAC00 \uB4E4\uB824\uC635\uB2C8\uB2E4. \uC774\uB7F0, \uBC15\uC950\uAD70\uC694!
      \r\n\uB2F9\uC2E0\uACFC \uC9C0\uC9C0\uB97C \uD569\uD55C \uAC83\uBCF4\uB2E4\uB3C4
      \uB354 \uD070 \uB369\uCE58\uB97C \uAC00\uC9C4 \uAC70\uB300 \uBC15\uC950\uAC00
      \uB2F9\uC2E0\uC744 \uC9C0\uAE0B\uC774 \uC751\uC2DC\uD569\uB2C8\uB2E4. \r\n\",,,\r\nP1,BRANCH,\uBA3C\uC800
      \uACF5\uACA9\uD55C\uB2E4.   (\uC804\uD22C),P_AFTER_BATTLE,StartBattle(Bat),DEFAULT\r\nP1,BRANCH,\uC870\uC6A9\uD788
      \uC9C0\uB098\uAC04\uB2E4. (\uBC40\uD30C\uC774\uC5B4\uC758 \uAFC8 \uC870\uAC01
      \uD544\uC694),P_VAMP,,HasDreamPiece(\uBC40\uD30C\uC774\uC5B4\uC758 \uAFC8)\r\nP_AFTER_BATTLE,DESC,\"\uC5B4\uB460
      \uC18D\uC5D0\uC11C\uC758 \uC0AC\uD22C \uB05D\uC5D0 \uB2F9\uC2E0\uC740 \uBC15\uC950\uB97C
      \uB5BC\uC5B4\uB0B4\uB294 \uB370 \uC131\uACF5\uD569\uB2C8\uB2E4! \uBC15\uC950\uB294
      \uB2F9\uC2E0\uC744 \uD55C \uBC88 \uB178\uB824\uBCF4\uACE0\uB294 \uC870\uC6A9\uD788
      \uC790\uB9AC\uB97C \uB5A0\uB0A9\uB2C8\uB2E4. \r\n\r\n\uBB34\uCC99\uC774\uB098
      \uAE30\uBD84 \uB098\uC05C \uC804\uD22C\uC600\uC2B5\uB2C8\uB2E4...\r\n\",,,DEFAULT\r\nP_AFTER_BATTLE,BRANCH,\uC790\uB9AC\uB97C
      \uB5A0\uB09C\uB2E4,END,,DEFAULT\r\nP_VAMP,DESC,\"\uBC15\uC950\uB294 \uB2F9\uC2E0\uC5D0\uAC8C
      \uC11C\uC11C\uD788 \uB2E4\uAC00\uC624\uB354\uB2C8\u2026\uB180\uB78D\uAC8C\uB3C4
      \uB2F9\uC2E0\uC5D0\uAC8C \uC791\uC740 \uC120\uBB3C\uC744 \uC8FC\uACE0\uB294
      \uC720\uC720\uD788 \uC790\uB9AC\uB97C \uB5A0\uB0A9\uB2C8\uB2E4! \uBC15\uC950\uC5D0\uAC8C
      \uC120\uBB3C\uC744 \uBC1B\uB2E4\uB2C8 \uC2E0\uAE30\uD55C \uACBD\uD5D8\uC774\uAD70\uC694.\r\n\r\n\uB2F9\uC2E0\uC740
      \uBC15\uC950\uC758 \uC120\uBB3C\uC744 \uC18C\uC911\uD788 \uC8FC\uC6CC\uB4E4\uACE0\uB294
      \uB2E4\uC74C \uC7A5\uC18C\uB85C \uD5A5\uD569\uB2C8\uB2E4.\r\n\",,GetObjet(\uBC15\uC950
      \uB0A0\uAC1C),\r\nP_VAMP,BRANCH,\uB5A0\uB09C\uB2E4,END,,DEFAULT\r\n"
  - id: ACT1_VAMP_INVITATION
    nameKO: "\uBC40\uD30C\uC774\uC5B4\uC758 \uCD08\uB300"
    type: 1
    imagePath: Vamp_Invitation
    filePath: Vamp_Invitation
    order: 4
    isEssential: 0
    constraint: 
    sourceCsvFile: {fileID: 0}
    csvRawData: 
  - id: ACT1_SHEEP_IN_MAZE
    nameKO: "\uAE38\uC744 \uC783\uC740 \uC0C1\uC778"
    type: 4
    imagePath: Sheep_in_Maze
    filePath: Sheep_in_Maze
    order: 0
    isEssential: 0
    constraint: 
    sourceCsvFile: {fileID: 0}
    csvRawData: "Page_ID,Type,Text_Content,Next_Page_ID,Call_Function,Constraint\r\nP1,DESC,\"\"\"\uC774\uAC70
      \uC815\uB9D0 \uD070\uC77C\uC778\uAC78. \uC774\uB7F0 \uACF3\uC5D0\uC11C \uAE38\uC744
      \uC783\uAC8C \uB418\uB2E4\uB2C8.\"\"\r\n\r\n\uBCF4\uB530\uB9AC\uB97C \uC794\uB729
      \uB4F1\uC5D0 \uC774\uACE0 \uC788\uB294 \uC591 \uC0C1\uC778\uC774 \uBB38\uC81C\uC5D0
      \uBE60\uC9C4 \uAC83 \uAC19\uC2B5\uB2C8\uB2E4. \r\n\r\n\"\"\uBBF8\uB85C\uAC00
      \uB108\uBB34 \uBCF5\uC7A1\uD574\uC11C \uAE38\uC744 \uC783\uC5B4\uBC84\uB838\uC9C0
      \uBB50\uC57C. \uC544\uBB34\uB798\uB3C4 \uBBF8\uB85C\uAC00 \uC544\uB2C8\uB77C
      \uB2E4\uB978 \uACF3\uC73C\uB85C \uC9C0\uB098\uAC00\uB294 \uAC8C \uC88B\uACA0\uC5B4.
      \uC544\uC774\uC57C, \uD639\uC2DC \uB098\uAC00\uB294 \uAE38\uC744 \uC54C\uACE0
      \uC788\uB2C8?\"\"\",,,\r\nP1,BRANCH,\uC548\uB2E4   (\uC9C0\uD61C>3),R,\"StartRoullete(Wisdom,
      3, upper,P2_S,P2_GS,P2_F) \",\r\nP1,BRANCH,\uBAA8\uB978\uB2E4,P_MERCHANT,,\r\nP2_S,DESC,\"\uB2F9\uC2E0\uC740
      \uAE30\uC5B5\uC744 \uB354\uB4EC\uC5B4 \uC785\uAD6C \uBC29\uD5A5\uC774 \uC5B4\uB514\uC600\uB294\uC9C0\uB97C
      \uAE30\uC5B5\uD574\uB0C5\uB2C8\uB2E4. \r\n\r\n\"\"\uADF8\uB807\uAD6C\uB098.
      \uADF8 \uC815\uB3C4\uBA74 \uC5B4\uB5BB\uAC8C\uB4E0 \uCC3E\uC544\uAC08 \uC218
      \uC788\uACA0\uC5B4. \uACE0\uB9C8\uC6CC!\"\"\r\n\r\n\uC591 \uC0C1\uC778\uC740
      \uB2F9\uC2E0\uC5D0\uAC8C \uB2F5\uB840\uB97C \uCC59\uACA8\uC900 \uD6C4, \uBCF4\uB530\uB9AC\uB97C
      \uB4E4\uACE0 \uB2F9\uC2E0\uC774 \uC54C\uB824\uC900 \uBC29\uD5A5\uC73C\uB85C
      \uD5A5\uD569\uB2C8\uB2E4.\r\n\r\n\uB2F9\uC2E0\uB3C4 \uB2E4\uC2DC \uCD9C\uAD6C\uB97C
      \uCC3E\uC544\uB098\uC12D\uB2C8\uB2E4.  \r\n\",,,\r\nP2_S,BRANCH,\uB5A0\uB09C\uB2E4,END,GetDebris(1),\r\nP2_GS,DESC,\"\uB2F9\uC2E0\uC740
      \uB6F0\uC5B4\uB09C \uAE30\uC5B5\uB825\uC73C\uB85C \uC785\uAD6C \uBC29\uD5A5\uC774
      \uC5B4\uB514\uC600\uB294\uC9C0\uB97C \uC815\uD655\uD558\uAC8C \uC54C\uB824\uC8FC\uC5C8\uC2B5\uB2C8\uB2E4.
      \r\n\r\n\"\"\uADF8\uB807\uAD6C\uB098. \uC774 \uBC29\uD5A5\uC73C\uB85C \uAC00\uBA74
      \uD655\uC2E4\uD788 \uC785\uAD6C\uAC00 \uB098\uC624\uACA0\uC5B4!\"\"\r\n\r\n\uC591
      \uC0C1\uC778\uC740 \uB2F9\uC2E0\uC5D0\uAC8C \uD6C4\uD55C \uB2F5\uB840\uB97C
      \uCC59\uACA8\uC900 \uD6C4, \uBCF4\uB530\uB9AC\uB97C \uB4E4\uACE0 \uB2F9\uC2E0\uC774
      \uC54C\uB824\uC900 \uBC29\uD5A5\uC73C\uB85C \uD5A5\uD569\uB2C8\uB2E4.\r\n\r\n\uB2F9\uC2E0\uB3C4
      \uB2E4\uC2DC \uCD9C\uAD6C\uB97C \uCC3E\uC544\uB098\uC12D\uB2C8\uB2E4.  \r\n\",,,\r\nP2_GS,BRANCH,\uB5A0\uB09C\uB2E4,END,GetDebris(2),\r\nP2_F,DESC,\"\uB2F9\uC2E0\uC740
      \uC785\uAD6C\uAC00 \uC5B4\uB514\uC600\uB294\uC9C0 \uCD5C\uC120\uC744 \uB2E4\uD574
      \uAE30\uC5B5\uD574\uBCF4\uB824 \uD558\uC9C0\uB9CC, \uC548\uD0C0\uAE5D\uAC8C\uB3C4
      \uB2F9\uC2E0\uC758 \uBA38\uB9AC \uB610\uD55C \uBBF8\uB85C \uC18D\uC5D0\uC11C
      \uD63C\uB780\uC2A4\uB7FD\uAE30\uB9CC \uD569\uB2C8\uB2E4.\r\n\r\n\"\"\uC73C\uC74C!
      \uB108\uB3C4 \uAE38\uC744 \uC783\uC5C8\uAD6C\uB098!\"\"\r\n\r\n\uC591 \uC0C1\uC778\uC740
      \uD638\uD638 \uC6C3\uC74C\uC744 \uC9C0\uC740 \uB4A4, \uBCF4\uB530\uB9AC\uB97C
      \uB4E4\uACE0 \uCD9C\uAD6C\uB97C \uCC3E\uC544 \uB5A0\uB0A9\uB2C8\uB2E4.\r\n\r\n\uB2F9\uC2E0\uB3C4
      \uC815\uB9D0\uB85C \uAE38\uC744 \uC783\uAE30 \uC804\uC5D0 \uBE68\uB9AC \uCD9C\uAD6C\uB97C
      \uCC3E\uC544\uC57C\uACA0\uB2E4\uB294 \uC0DD\uAC01\uC774 \uB4ED\uB2C8\uB2E4.\r\n\",,,\r\nP2_F,BRANCH,\uB5A0\uB09C\uB2E4,END,\"DownStatus(Courage,1)\",\r\nP_MERCHANT,DESC,\"\"\"\uC5B4\uCA54
      \uC218 \uC5C6\uC9C0. \uADF8\uB7FC \uB9CC\uB09C \uAE40\uC5D0 \uB3C4\uC6C0\uC774
      \uB420 \uBB3C\uAC74\uC774\uB098 \uD55C \uBC88 \uACE8\uB77C\uBD10!\"\"\r\n\",,,\r\nP_MERCHANT,BRANCH,\"\uC0C1\uC810\uC744
      \uB458\uB7EC\uBCF8\uB2E4\r\n\r\n\",P_AFTER_MERCHANT,meetMerchant(),\r\nP_AFTER_MERCHANT,DESC,\"\"\"\uADF8\uB798,
