        \uCEF5\uC744 \uB530\uB77C \uBE59\uAE00\uBE59\uAE00 \uB3D5\uB2C8\uB2E4. \n\uBE59\uAE00\uBE59\uAE00
        \uB3D5\uB2C8\uB2E4\u2026\n\n\"\"\uC548 \uB3FC, \uADF8\uB9CC \uBA48\uCDB0\uC57C
        \uD574!\"\"\n\uB2F9\uC2E0\uC740 \uC544\uB791\uACF3 \uD558\uC9C0 \uC54A\uACE0
        \uBE59\uAE00\uBE59\uAE00 \uB3D5\uB2C8\uB2E4.\n\"\"\uC73C\uC73D,\uBA48\uCDB0\uC57C
        \uD558\uB294\uB370...\uBE59\uAE00\uBE59\uAE00\u2026\"\" \n\n\uB108\uB3C4
        \uD568\uAED8 \uB098\uB3C4 \uD568\uAED8 \uBE59\uAE00\uBE59\uAE00 \uB3D5\uB2C8\uB2E4.\n\",,,\nP_SPIN,BRANCH,\"\uB2E4\uC74C\n\",P_AFTER_SPIN,GetObjet(),\nP_AFTER_SPIN,DESC,\"\uD55C\uBC14\uD0D5
        \uC815\uC2E0\uC5C6\uC774 \uB3CC\uACE0\uB098\uB2C8 \uB2F9\uC2E0\uC740 \uC138\uC0C1\uC774
        \uC0C8\uB86D\uAC8C \uBCF4\uC785\uB2C8\uB2E4. \n\uB9C8\uCE58 \uC0C8\uB85C
        \uD0DC\uC5B4\uB09C \uAC83\uB9CC \uAC19\uC740 \uAE30\uBD84\uC744 \uB9CC\uB07D\uD558\uBA70
        \uB2F9\uC2E0\uC740 \uBE59\uAE00\uBE59\uAE00 \uAC78\uC5B4\uAC11\uB2C8\uB2E4.\",,,\nP_AFTER_SPIN,BRANCH,\uBE59\uAE00\uBE59\uAE00!,END,,\n"
