    encounterContext:
      csvRawData: "Page_ID,Type,Text_Content,Next_Page_ID,Call_Function,Constraint,\nP1,DESC,\"\uC720\uB839\uC758
        \uC9D1\uC744 \uB3CC\uC544\uB2E4\uB2C8\uACE0 \uC788\uB294 \uB2F9\uC2E0\uC758
        \uC55E\uC5D0 \uD2B9\uC774\uD55C \uBD84\uC704\uAE30\uC758 \uC720\uB839\uC774
        \uD558\uB098 \uB098\uD0C0\uB0A9\uB2C8\uB2E4.\n\n\"\"\uC73C\u2026\uC73C\u2026\"\"\n\n\uC720\uB839\uC740
        \uAD34\uC0C1\uD55C \uC18C\uB9AC\uB97C \uB0B4\uBA70 \uB2F9\uC2E0\uC5D0\uAC8C
        \uB2E4\uAC00\uC635\uB2C8\uB2E4.\n\n\",,,\nP1,BRANCH,\"\uC720\uB839\uC744
        \uBB3C\uB9AC\uCE5C\uB2E4.   (\uC804\uD22C)\n\",P_AFTER_BATTLE,StartBattle(GuestOrGhost),DEFAULT\nP1,BRANCH,\uC720\uB839\uC5D0\uAC8C
        \uC778\uC0AC\uB97C \uAC74\uB128\uB2E4.,P_HELLO,,\nP_AFTER_BATTLE,DESC,\"\"\"\uC9D1\uC5D0\u2026\uC2F6\u2026\uC778\uB370\u2026\"\"\n\n\uC720\uB839\uC740
        \uC54C\uC544\uB4E3\uAE30 \uD798\uB4E0 \uB9D0\uC744 \uB0A8\uAE30\uACE0 \uD615\uCCB4\uB3C4
        \uC5C6\uC774 \uC0AC\uB77C\uC9D1\uB2C8\uB2E4.\n\n\uB2F9\uC2E0\uC740 \uAC00\uB358
        \uAE38\uC744 \uACC4\uC18D\uD574\uC11C \uAC78\uC5B4\uAC11\uB2C8\uB2E4.\",,,DEFAULT\nP_AFTER_BATTLE,BRANCH,\uB5A0\uB09C\uB2E4,END,,DEFAULT\nP_HELLO,DESC,\"\"\"\uC9D1\u2026\uAC00...\"\"\n\n\uC720\uB839\uC740
        \uD750\uB9B0 \uBC1C\uC74C\uC73C\uB85C \uC774\uC57C\uAE30\uB97C \uACC4\uC18D\uD569\uB2C8\uB2E4.
        \uBB34\uC2A8 \uB9D0\uC778\uC9C0 \uC54C\uC544\uB4E3\uAE30\uAC00 \uC27D\uC9C0
        \uC54A\uAD70\uC694.\",,,\nP_HELLO,BRANCH,\"\uC720\uB839\uC744 \uBB3C\uB9AC\uCE5C\uB2E4.  
        (\uC804\uD22C)\n\",P_AFTER_BATTLE,StartBattle(GuestOrGhost),DEFAULT\nP_HELLO,BRANCH,\"\uC9D1\uC911\uD574\uC11C
        \uADC0\uB97C \uAE30\uC6B8\uC5EC\uBCF8\uB2E4.   (\uC9C0\uD61C >3)\n\n\",,\"StartRoullete(Wisdom,
        3, upper,P2_S,P2_GS,P2_F) \",\nP2_S,DESC,\"\uB2F9\uC2E0\uC740 \uC9D1\uC911\uB825\uC744
        \uBC1C\uD718\uD574\uC11C \uC720\uB839\uC758 \uB9D0\uC744 \uD574\uC11D\uD574\uBCF4\uAE30\uB85C
        \uD569\uB2C8\uB2E4. \uB2E4\uD589\uD788 \uC870\uAE08\uC529 \uB4E4\uB9AC\uB294
        \uAC83 \uAC19\uAD70\uC694. \n\"\"\uB09C\u2026\uC720\uB839... \uC544\uB2C8\u2026.\"\"\n\"\"..\uC804\uC5D0...\uC783\uC5B4\uC11C\u2026\uACC4\uC18D...\uC774\uB807\uAC8C\u2026\"\"\n\n\uBB34\uC2A8
        \uB9D0\uC778\uC9C0 \uC815\uD655\uD558\uAC8C\uB294 \uBAA8\uB974\uACA0\uC9C0\uB9CC,
        \uC544\uBB34\uD2BC \uC774 \uC7A5\uC18C\uAC00 \uAE30\uBD84 \uB098\uC05C \uACF3\uC774\uB77C\uB294
        \uAC74 \uD655\uC2E4\uD574 \uBCF4\uC785\uB2C8\uB2E4. \n\uB2F9\uC2E0\uC740
        \uC774\uACF3\uC744 \uBE68\uB9AC \uBE60\uC838\uB098\uAC00\uC57C\uACA0\uB2E4\uACE0
        \uC0DD\uAC01\uD569\uB2C8\uB2E4. \n\",,,DEFAULT\nP2_S,BRANCH,\uC11C\uB458\uB7EC
        \uB5A0\uB09C\uB2E4,END,,\nP2_GS,DESC,\"\uB2F9\uC2E0\uC740 \uC9D1\uC911\uB825\uC744
        \uBC1C\uD718\uD574\uC11C \uC720\uB839\uC758 \uB9D0\uC744 \uD574\uC11D\uD574\uBCF4\uAE30\uB85C
        \uD569\uB2C8\uB2E4. \uB2E4\uD589\uD788 \uC720\uB839\uC758 \uB9D0\uC774 \uC798
        \uB4E4\uB9AC\uB294 \uAC83 \uAC19\uAD70\uC694. \n\"\"\uB09C\u2026\uC720\uB839\uC774
        \uC544\uB2C8\uC5C8\uC5B4\u2026.\"\"\n\"\"\uC624\uB798 \uC804\uC5D0 \uAE38\uC744
        \uC783\uC5B4\uC11C\u2026\uACC4\uC18D \uC5EC\uAE30 \uC788\uB2E4 \uBCF4\uB2C8
        \uC774\uB807\uAC8C\u2026\"\"\n\n\uC774\uB7F4 \uC218\uAC00! \uC774 \uC720\uB839\uC740
        \uC6D0\uB798 \uC720\uB839\uC774 \uC544\uB2C8\uC5C8\uB2E4\uACE0 \uD569\uB2C8\uB2E4!
        \n\uB2F9\uC2E0\uC740 \uBE68\uB9AC \uC774 \uBD88\uAE38\uD55C \uC7A5\uC18C\uB97C
        \uBE60\uC838\uB098\uAC00\uC57C\uACA0\uB2E4\uB294 \uC0DD\uAC01\uC774 \uB4ED\uB2C8\uB2E4.\n\n\"\"\uBC15\uC950\u2026\uBC15\uC950\uB97C
        \uC870\uC2EC\uD574\u2026\"\"\n\uC720\uB839\uC740 \uB9C8\uC9C0\uB9C9\uC73C\uB85C
        \uC758\uBBF8\uC2EC\uC7A5\uD55C \uB9D0\uC744 \uB0A8\uAE30\uACE0 \uD615\uCCB4\uB3C4
        \uC5C6\uC774 \uC0AC\uB77C\uC9D1\uB2C8\uB2E4.\n\n\uB2F9\uC2E0\uC740 \uC720\uB839\uC774
        \uB0A8\uAE34 \uB9D0\uC744 \uC0DD\uAC01\uD574\uBCF4\uB2E4\uAC00 \uB2E4\uC2DC
        \uAE38\uC744 \uB5A0\uB0A9\uB2C8\uB2E4.\n\n\",,\"UpStatus(Wisdom,1)\",\nP2_GS,BRANCH,\uB5A0\uB09C\uB2E4,END,,\nP2_F,DESC,\"\uB2F9\uC2E0\uC740
        \uC9D1\uC911\uB825\uC744 \uBC1C\uD718\uD574\uC11C \uC720\uB839\uC758 \uB9D0\uC744
        \uD574\uC11D\uD574\uBCF4\uAE30\uB85C \uD569\uB2C8\uB2E4. \n\"\"\uB09C\u2026\uC544.\"\"\n\"\"..\uC804...\uC5B4\uC11C\u2026\uB807\uAC8C\u2026\"\"\n\n\uADF8\uB7EC\uB098
        \uC5EC\uC804\uD788 \uBB34\uC2A8 \uB9D0\uC778\uC9C0 \uC54C\uC544\uB4E4\uC744
        \uC218 \uC5C6\uAD70\uC694. \uC720\uB839\uC740 \uC774\uD574\uB418\uC9C0 \uC54A\uB294
        \uB9D0\uC744 \uB0A8\uAE30\uB2E4\uAC00 \uD615\uCCB4\uB3C4 \uC5C6\uC774 \uC0AC\uB77C\uC9D1\uB2C8\uB2E4.\n\uB2F9\uC2E0\uC740
        \uAC81\uC5D0 \uC9C8\uB9B0 \uCC44 \uC774\uACF3\uC744 \uBE68\uB9AC \uBE60\uC838\uB098\uAC00\uC57C\uACA0\uB2E4\uACE0
        \uC0DD\uAC01\uD569\uB2C8\uB2E4. \n\",,,\nP2_F,BRANCH,\uC11C\uB458\uB7EC \uB5A0\uB09C\uB2E4,END,\"DownStatus(Courage,
        1)\",\n"
