        \uC81C\uBC95 \uC624\uB798 \uBBF8\uB85C \uC815\uC6D0\uC744 \uAC78\uC5C8\uC9C0\uB9CC,
        \uC544\uC9C1\uB3C4 \uCD9C\uAD6C\uB97C \uCC3E\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4.
        \uC774\uC81C \uC2AC\uC2AC \uD2B9\uB2E8\uC758 \uACB0\uC815\uC744 \uB0B4\uB9B4
        \uB54C\uAC00 \uB41C \uAC83 \uAC19\uAD70\uC694!\",,,\nP1,BRANCH,\uC9C0\uC9C0\uC5D0\uAC8C
        \uAE38\uC548\uB0B4\uB97C \uB9E1\uAE34\uB2E4,P_ZIZI,,\nP1,BRANCH,\uAC10\uC744
        \uBBFF\uACE0 \uAC04\uB2E4   (\uD589\uC6B4 >4),P_BLOOD,\"StartRoullete(Luck,
        4, upper,P2_S,P2_GS,P2_F) \",\nP1,BRANCH,\uAE30\uC5B5\uC744 \uCC9C\uCC9C\uD788
        \uB418\uC9DA\uC5B4\uBCF8\uB2E4   (\uC9C0\uD61C >4),P_WINE,\"StartRoullete(Wisdom,
        4, upper,P3_S,P3_GS,P3_F) \",\nP_ZIZI,DESC,\"\"\"\uB098\uB3C4 \uAE30\uC5B5\uC740
        \uC798 \uC548 \uB098\uB294\uB370\u2026\"\"\n\n\uB2F9\uC2E0\uC740 \uC9C0\uC9C0\uB97C
        \uB530\uB77C \uD558\uC5FC\uC5C6\uC774 \uAC77\uC2B5\uB2C8\uB2E4. \uACB0\uAD6D
        \uBC18\uB098\uC808\uC744 \uB354 \uD5E4\uBA54\uC774\uB2E4\uAC00 \uACA8\uC6B0
        \uBBF8\uB85C\uB97C \uBE60\uC838\uB098\uC624\uB294 \uB370 \uC131\uACF5\uD569\uB2C8\uB2E4!\n\n\uC81C\uBC95
        \uD798\uB4E0 \uC5EC\uC815\uC774\uC5C8\uC2B5\uB2C8\uB2E4.\",,,\nP_ZIZI,BRANCH,\uBBF8\uB85C\uB97C
        \uD0C8\uCD9C\uD55C\uB2E4,END,\"LoseHP(5, per)\",\nP2_S,DESC,\"\uB2F9\uC2E0\uC740
        \uC2A4\uC2A4\uB85C\uC758 \uC6B4\uC744 \uBBFF\uACE0 \uB9C8\uC74C\uC774 \uB0B4\uD0A4\uB294
        \uB300\uB85C \uAC77\uAE30 \uC2DC\uC791\uD569\uB2C8\uB2E4. \uC9C0\uC9C0\uAC00
        \uB2F9\uC2E0\uC744 \uC758\uC2EC\uC758 \uB208\uCD08\uB9AC\uB85C \uCCD0\uB2E4\uBCF4\uC9C0\uB9CC
        \uB2F9\uC2E0\uC740 \uAC1C\uC758\uCE58 \uC54A\uC2B5\uB2C8\uB2E4. \n\n\uADF8\uB9AC\uACE0
        \uACB0\uAD6D \uD55C \uC2DC\uAC04\uB3C4 \uAC78\uB9AC\uC9C0 \uC54A\uC544 \uBBF8\uB85C\uB97C
        \uD0C8\uCD9C\uD558\uB294 \uB370 \uC131\uACF5\uD569\uB2C8\uB2E4!\n\n\"\"\uC6B4\uC774
        \uC88B\uAD70\u2026\"\"\n\n\uACFC\uC815\uC740 \uC870\uAE08 \uC5C9\uC131\uD588\uC9C0\uB9CC,
        \uD0C8\uCD9C\uD588\uC73C\uB2C8 \uADF8\uB9CC \uC544\uB2D0\uAE4C\uC694!\",,,\nP2_S,BRANCH,\uBBF8\uB85C\uB97C
        \uD0C8\uCD9C\uD55C\uB2E4,END,,\nP2_GS,DESC,\"\uB2F9\uC2E0\uC740 \uC2A4\uC2A4\uB85C\uC758
        \uC6B4\uC744 \uBBFF\uACE0 \uB9C8\uC74C\uC774 \uB0B4\uD0A4\uB294 \uB300\uB85C
        \uAC77\uAE30 \uC2DC\uC791\uD569\uB2C8\uB2E4. \uC9C0\uC9C0\uAC00 \uB2F9\uC2E0\uC744
        \uC758\uC2EC\uC758 \uB208\uCD08\uB9AC\uB85C \uCCD0\uB2E4\uBCF4\uC9C0\uB9CC
        \uB2F9\uC2E0\uC740 \uAC1C\uC758\uCE58 \uC54A\uC2B5\uB2C8\uB2E4. \n\n\uADF8\uB9AC\uACE0
        \uACB0\uAD6D \uD55C \uC2DC\uAC04\uB3C4 \uAC78\uB9AC\uC9C0 \uC54A\uC544 \uBBF8\uB85C\uB97C
        \uD0C8\uCD9C\uD558\uB294 \uB370 \uC131\uACF5\uD569\uB2C8\uB2E4! \uAC8C\uB2E4\uAC00
        \uD0C8\uCD9C\uD558\uB294 \uACFC\uC815\uC5D0\uC11C \uAE38\uAC00\uC5D0 \uB5A8\uC5B4\uC9C4
        \uB3D9\uC804 \uD558\uB098\uB3C4 \uC8FC\uC6B8 \uC218 \uC788\uC5C8\uC2B5\uB2C8\uB2E4!
        \n\n\"\"\uC6B4\uC774 \uC88B\uAD70\u2026\"\"\n\n\uB2F9\uC2E0\uC740 \uC790\uC2E0\uC758
        \uC6B4\uC744 \uCE6D\uCC2C\uD558\uBA70 \uBBF8\uB85C\uC758 \uBC16\uC73C\uB85C
        \uD5A5\uD569\uB2C8\uB2E4.\",,,\nP2_GS,BRANCH,\uBBF8\uB85C\uB97C \uD0C8\uCD9C\uD55C\uB2E4,END,GetDebris(1),\nP2_F,DESC,\"\uB2F9\uC2E0\uC740
        \uC2A4\uC2A4\uB85C\uC758 \uC6B4\uC744 \uBBFF\uACE0 \uB9C8\uC74C\uC774 \uB0B4\uD0A4\uB294
        \uB300\uB85C \uAC77\uAE30 \uC2DC\uC791\uD569\uB2C8\uB2E4. \uC9C0\uC9C0\uAC00
        \uB2F9\uC2E0\uC744 \uC758\uC2EC\uC758 \uB208\uCD08\uB9AC\uB85C \uCCD0\uB2E4\uBCF4\uC9C0\uB9CC
        \uB2F9\uC2E0\uC740 \uAC1C\uC758\uCE58 \uC54A\uC2B5\uB2C8\uB2E4. \n\n\uADF8\uB9AC\uACE0
        \uACB0\uAD6D\u2026\uB2F9\uC2E0\uC740 \uBC18\uB098\uC808\uC744 \uB354 \uD5E4\uBA54\uC774\uB2E4\uAC00
        \uACA8\uC6B0 \uBBF8\uB85C\uB97C \uBE60\uC838\uB098\uC62C \uC218 \uC788\uC5C8\uC2B5\uB2C8\uB2E4.\n\"\"\uB108\uBB34
        \uAC78\uC5C8\uB354\uB2C8 \uD53C\uACE4\uD55C\uAC78\u2026\"\"\n\n\uB2F9\uC2E0\uB3C4
        \uC9C0\uC9C0\uC758 \uB9D0\uC5D0 \uACF5\uAC10\uD569\uB2C8\uB2E4. \uC815\uB9D0
        \uD798\uB4E0 \uC5EC\uC815\uC774\uC5C8\uC2B5\uB2C8\uB2E4\u2026\",,,\nP2_F,BRANCH,\uBBF8\uB85C\uB97C
        \uD0C8\uCD9C\uD55C\uB2E4,END,\"LoseHP(10, per)\",\nP3_S,DESC,\"\uB2F9\uC2E0\uC740
        \uC9C0\uAE08\uAE4C\uC9C0 \uAC78\uC5B4\uC628 \uAE30\uC5B5\uC744 \uCC9C\uCC9C\uD788
        \uB418\uC9DA\uC5B4\uBCF4\uBA74\uC11C, \uC774\uBBF8 \uC640\uBD24\uB358 \uAE38\uC740
        \uD53C\uD558\uACE0 \uCC98\uC74C \uAC00\uB294 \uAE38\uB9CC \uACE8\uB77C\uC11C
        \uD604\uBA85\uD558\uAC8C \uAE38\uC744 \uCC3E\uC2B5\uB2C8\uB2E4. \uC911\uAC04\uC911\uAC04
        \uC2E4\uC218\uB3C4 \uC788\uC5C8\uC9C0\uB9CC, \uACB0\uAD6D \uD55C \uC2DC\uAC04\uB3C4
        \uAC78\uB9AC\uC9C0 \uC54A\uC544 \uBBF8\uB85C\uB97C \uD0C8\uCD9C\uD558\uB294
        \uB370 \uC131\uACF5\uD569\uB2C8\uB2E4! \n\n\"\"\uC73C\uC73C, \uB4DC\uB514\uC5B4
        \uD0C8\uCD9C\uC774\uB2E4!\"\"\n\n\uC9C0\uC9C0\uAC00 \uBBF8\uB85C\uB77C\uBA74
        \uC9C0\uAE0B\uC9C0\uAE0B\uD558\uB2E4\uB294 \uB4EF\uC774 \uB9D0\uD569\uB2C8\uB2E4.\n\uB2F9\uC2E0\uB3C4
        \uACE0\uAC1C\uB97C \uD55C \uBC88 \uB044\uB355\uC774\uACE0\uB294 \uBBF8\uB85C\uC758
        \uBC16\uC73C\uB85C \uD5A5\uD569\uB2C8\uB2E4.\",,,\nP3_S,BRANCH,\uBBF8\uB85C\uB97C
        \uD0C8\uCD9C\uD55C\uB2E4,END,,\nP3_GS,DESC,\"\uB2F9\uC2E0\uC740 \uC9C0\uAE08\uAE4C\uC9C0
        \uAC78\uC5B4\uC628 \uAE30\uC5B5\uC744 \uCC9C\uCC9C\uD788 \uB418\uC9DA\uC5B4\uBCF4\uBA74\uC11C,
        \uC774\uBBF8 \uC640\uBD24\uB358 \uAE38\uC740 \uD53C\uD558\uACE0 \uCC98\uC74C
        \uAC00\uB294 \uAE38\uB9CC \uACE8\uB77C\uC11C \uD604\uBA85\uD558\uAC8C \uAE38\uC744
        \uCC3E\uC2B5\uB2C8\uB2E4. \uB2F9\uC2E0\uC758 \uC644\uBCBD\uD55C \uAE30\uC5B5\uB825
        \uB355\uBD84\uC5D0 \uACB0\uAD6D \uD55C \uC2DC\uAC04\uB3C4 \uAC78\uB9AC\uC9C0
        \uC54A\uC544 \uBBF8\uB85C\uB97C \uD0C8\uCD9C\uD558\uB294 \uB370 \uC131\uACF5\uD569\uB2C8\uB2E4!
        \uAC8C\uB2E4\uAC00 \uD0C8\uCD9C\uD558\uB294 \uACFC\uC815\uC5D0\uC11C \uAE38\uAC00\uC5D0
        \uB5A8\uC5B4\uC9C4 \uB3D9\uC804 \uD558\uB098\uB3C4 \uC8FC\uC6B8 \uC218 \uC788\uC5C8\uC2B5\uB2C8\uB2E4!
        \n\n\"\"\uC73C\uC73C, \uB4DC\uB514\uC5B4 \uD0C8\uCD9C\uC774\uB2E4!\"\"\n\n\uC9C0\uC9C0\uAC00
        \uBBF8\uB85C\uB77C\uBA74 \uC9C0\uAE0B\uC9C0\uAE0B\uD558\uB2E4\uB294 \uB4EF\uC774
        \uB9D0\uD569\uB2C8\uB2E4.\n\uB2F9\uC2E0\uB3C4 \uACE0\uAC1C\uB97C \uD55C \uBC88
        \uB044\uB355\uC774\uACE0\uB294 \uBBF8\uB85C\uC758 \uBC16\uC73C\uB85C \uD5A5\uD569\uB2C8\uB2E4.\",,,\nP3_GS,BRANCH,\uBBF8\uB85C\uB97C
        \uD0C8\uCD9C\uD55C\uB2E4,END,GetDebris(1),\nP3_F,DESC,\"\uB2F9\uC2E0\uC740
        \uC2A4\uC2A4\uB85C\uC758 \uAE30\uC5B5\uC744 \uBBFF\uACE0 \uC640\uBD24\uB358
        \uAE38\uC740 \uD53C\uD558\uBA74\uC11C \uCC98\uC74C \uAC00\uB294 \uAE38\uB9CC
        \uACE8\uB77C \uAE38\uC744 \uCC3E\uC2B5\uB2C8\uB2E4. \uADF8\uB7EC\uB098 \uC774\uB7F0,
        \uBA87\uBA87 \uAE38\uC774 \uC640\uBD24\uB358 \uAE38\uC778\uC9C0 \uC544\uB2CC\uC9C0
        \uC798 \uAD6C\uBD84\uC774 \uB418\uC9C0 \uC54A\uB294\uAD70\uC694! \n\n\uACB0\uAD6D,
        \uB2F9\uC2E0\uC740 \uBC18\uB098\uC808\uC744 \uB354 \uD5E4\uBA54\uC774\uB2E4\uAC00
        \uACA8\uC6B0 \uBBF8\uB85C\uB97C \uBE60\uC838\uB098\uC62C \uC218 \uC788\uC5C8\uC2B5\uB2C8\uB2E4.\n\"\"\uB108\uBB34
        \uAC78\uC5C8\uB354\uB2C8 \uD53C\uACE4\uD55C\uAC78\u2026\"\"\n\n\uB2F9\uC2E0\uB3C4
        \uC9C0\uC9C0\uC758 \uB9D0\uC5D0 \uACF5\uAC10\uD569\uB2C8\uB2E4. \uC815\uB9D0
        \uD798\uB4E0 \uC5EC\uC815\uC774\uC5C8\uC2B5\uB2C8\uB2E4\u2026\",,,\nP3_F,BRANCH,\uBBF8\uB85C\uB97C
        \uD0C8\uCD9C\uD55C\uB2E4,END,\"LoseHP(10, per)\",\n"
