        \uC218\uC0C1\uD55C \uBE68\uAC04 \uC790\uAD6D\uB4E4\uC774 \uBCF4\uC774\uB294
        \uB4EF\uD569\uB2C8\uB2E4.\n\n\"\"\uC124\uB9C8 \uB2E4\uAC00\uAC00\uB824\uB294
        \uAC74 \uC544\uB2C8\uC9C0?\"\"\n\",,,\nP1,BRANCH,\uB2E4\uAC00\uAC04\uB2E4  
        (\uC804\uD22C),P_AFTER_BATTLE,StartBattle(CruelFlower),DEFAULT\nP1,BRANCH,\uC9C0\uB098\uAC04\uB2E4,P_PASS,,\nP_AFTER_BATTLE,DESC,\"\uB2F9\uC2E0\uC740
        \uB09C\uD3ED\uD55C \uAF43\uC744 \uC81C\uC555\uD558\uB294 \uB370 \uC131\uACF5\uD588\uC2B5\uB2C8\uB2E4!
        \uD22C\uC7C1\uC758 \uC804\uB9AC\uD488\uC73C\uB85C \uB2EC\uAF3C\uD55C \uAFC0\uC744
        \uB9DB\uBCFC \uC218 \uC788\uC5C8\uC2B5\uB2C8\uB2E4.\n\n\"\"\uC74C, \uB9DB\uC788\uB2E4.
        \uC5ED\uC2DC \uB178\uB825\uD558\uB294 \uACE0\uC591\uC774\uAC00 \uB2EC\uCF64\uD55C
        \uAFC0\uC744 \uC5BB\uB294 \uAC70\uC9C0!\"\"\n\uB2F9\uC2E0\uC740 \uD761\uC871\uD574\uD558\uB294
        \uC9C0\uC9C0\uC640 \uD568\uAED8 \uB2E4\uC2DC \uAE38\uC744 \uB5A0\uB0A9\uB2C8\uB2E4.\n\",,GetObjet(Honey),DEFAULT\nP_AFTER_BATTLE,BRANCH,\uB5A0\uB09C\uB2E4,END,,DEFAULT\nP_PASS,DESC,\uD604\uBA85\uD55C
        \uB2F9\uC2E0\uC740 \uAF43\uACFC \uBA40\uCC0D\uC774 \uB5A8\uC5B4\uC838 \uC9C0\uB098\uAC11\uB2C8\uB2E4.
        \uC544\uBB34 \uC77C\uB3C4 \uC77C\uC5B4\uB098\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4.
