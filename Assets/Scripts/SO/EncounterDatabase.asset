      csvRawData: "Page_ID,Type,Text_Content,Next_Page_ID,Call_Function,Constraint,\nP1,DESC,\"\uC720\uB839\uC758
        \uC9D1\uC5D0 \uB4E4\uC5B4\uC11C\uACE0 \uC5BC\uB9C8 \uC9C0\uB098\uC9C0 \uC54A\uC544,
        \uB2F9\uC2E0\uC740 \uC606\uC790\uB9AC\uAC00 \uD5C8\uC804\uD568\uC744 \uAE68\uB2EB\uC2B5\uB2C8\uB2E4.\n\n\uC774\uB7F0,
        \uB2F9\uC2E0\uC758 \uC0AC\uB791\uC2A4\uB7F0 \uCE5C\uAD6C \uC9C0\uC9C0\uAC00
        \uC0AC\uB77C\uC84C\uAD70\uC694!\n\",,,\nP1,BRANCH,\"\uC9C0\uC9C0?\n\",P2,,DEFAULT\nP2,DESC,\"\uB2F9\uC2E0\uC758
        \uC18C\uB9AC\uB294 \uACF5\uD5C8\uD55C \uBCF5\uB3C4\uC5D0 \uBA54\uC544\uB9AC\uCCD0
        \uB3CC\uC544\uC62C \uBFD0\uC785\uB2C8\uB2E4.\n\n\uADF8\uB7F0\uB370 \uC7A0\uAE50!
        \uC5B4\uB518\uAC00\uC5D0\uC11C \uACE0\uC591\uC774 \uC6B8\uC74C\uC18C\uB9AC\uAC00
        \uB4E4\uB9AC\uB294 \uAC83\uB3C4 \uAC19\uAD70\uC694!\",,,\nP2,BRANCH,\"\uC6B8\uC74C
        \uC18C\uB9AC\uB97C \uB530\uB77C\uAC00\uBCF8\uB2E4.\n\",P_TRACE,,DEFAULT\nP2,BRANCH,\uAC00\uB9CC\uD788
        \uC788\uB294\uB2E4.,P_STOP,,DEFAULT\nP_TRACE,DESC,\"\uC6B8\uC74C\uC18C\uB9AC\uAC00
        \uB098\uB294 \uACF3\uC5D0\uB294\u2026\uACE0\uC591\uC774\uAC00 \uD55C \uB9C8\uB9AC
        \uC788\uC5C8\uC2B5\uB2C8\uB2E4.\n\n\uD558\uC9C0\uB9CC \uADF8 \uACE0\uC591\uC774\uB294
        \uC9C0\uC9C0\uCC98\uB7FC \uADC0\uC5FD\uC9C0\uB294 \uC54A\uAD70\uC694. \uADF8\uB9AC\uACE0\u2026\n\n\uB2F9\uC2E0\uC5D0\uAC8C
        \uB2EC\uB824\uB4E4\uAE30 \uC2DC\uC791\uD569\uB2C8\uB2E4!\",,,\nP_TRACE,BRANCH,\uB9DE\uC11C
        \uC2F8\uC6B4\uB2E4   (\uC804\uD22C),T_AFTER_BATTLE,StartBattle(ScaryCat),DEFAULT\nP_STOP,DESC,\"\"\"\uC65C
        \uAC00\uB9CC\uD788 \uC11C \uC788\uB294 \uAC70\uC57C?\"\"\n\n\uC5B4\uB77C?
        \uC774\uAC70 \uC774\uC0C1\uD558\uAD70\uC694. \uB2F9\uC2E0 \uC606\uC5D0 \uC5B4\uB290\uC0C8
        \uC9C0\uC9C0\uAC00 \uB3CC\uC544\uC640\uC788\uC2B5\uB2C8\uB2E4! \n\n\"\"\uBB34\uC2A8
        \uC18C\uB9AC\uC57C. \uB09C \uC544\uAE4C\uBD80\uD130 \uACC4\uC18D \uC5EC\uAE30\uC5D0
        \uC788\uC5C8\uB2E4\uACE0.\"\"\n\n\uC774\uB7F4 \uC218\uAC00. \uBB34\uC5C7\uC5D0
        \uD640\uB9AC\uAE30\uB77C\uB3C4 \uD55C \uAC78\uAE4C\uC694? \uBC29\uAE08 \uC788\uC5C8\uB358
        \uC77C\uC744 \uC0DD\uAC01\uD558\uB2C8 \uAD1C\uD788 \uC73C\uC2A4\uC2A4\uD574\uC9C0\uB294\uAD70\uC694.\n\n\uD558\uC9C0\uB9CC
        \uC774\uC81C \uAC71\uC815 \uC5C6\uC2B5\uB2C8\uB2E4. \uB2F9\uC2E0\uC5D0\uAC8C\uB294
        \uB4E0\uB4E0\uD55C \uCE5C\uAD6C \uC9C0\uC9C0\uAC00 \uD568\uAED8 \uC788\uC73C\uB2C8\uAE4C\uC694!\n\n\uB2F9\uC2E0\uC740
        \uB2E4\uC2DC \uC6A9\uAE30\uB97C \uB0B4\uC5B4 \uC720\uB839\uC758 \uC9D1\uC744
        \uD0D0\uD5D8\uD558\uAE30 \uC2DC\uC791\uD569\uB2C8\uB2E4.\",,\"UpStatus(Courage,
        1)\",\nP_STOP,BRANCH,\"\uB5A0\uB09C\uB2E4\n\",END,,DEFAULT\nT_AFTER_BATTLE,DESC,\"\uD6C4\uC6B0,
        \uC815\uB9D0 \uC0AC\uB098\uC6B4 \uACE0\uC591\uC774\uC600\uC2B5\uB2C8\uB2E4.
        \uADF8\uB9AC\uACE0 \uD798\uACA8\uC6B4 \uC804\uD22C\uC5D0\uC11C \uC2B9\uB9AC\uD55C
        \uB2F9\uC2E0\uC758 \uC606\uC5D4\u2026\n\n\"\"\uB300\uCCB4 \uC544\uAE4C\uBD80\uD130
        \uAC00\uB9CC\uD788 \uC11C\uC11C \uBB50 \uD558\uB294 \uAC70\uC57C?\"\"\n\n\uC5B4\uB77C?
        \uC774\uAC70 \uC774\uC0C1\uD558\uAD70\uC694. \uB2F9\uC2E0 \uC606\uC5D0 \uC5B4\uB290\uC0C8
        \uC9C0\uC9C0\uAC00 \uB3CC\uC544\uC640\uC788\uC2B5\uB2C8\uB2E4! \n\n\"\"\uBB34\uC2A8
        \uC18C\uB9AC\uC57C. \uB09C \uC544\uAE4C\uBD80\uD130 \uACC4\uC18D \uC5EC\uAE30\uC5D0
        \uC788\uC5C8\uB2E4\uACE0.\"\"\n\n\uC774\uB7F4 \uC218\uAC00. \uBB34\uC5C7\uC5D0
        \uD640\uB9AC\uAE30\uB77C\uB3C4 \uD55C \uAC78\uAE4C\uC694? \uBC29\uAE08 \uC788\uC5C8\uB358
        \uC77C\uC744 \uC0DD\uAC01\uD558\uB2C8 \uAD1C\uD788 \uC73C\uC2A4\uC2A4\uD574\uC9C0\uB294\uAD70\uC694.\n\n\uB2F9\uC2E0\uC740
        \uC794\uB729 \uAE34\uC7A5\uD55C \uCC44\uB85C \uC774\uACF3\uC744 \uBE68\uB9AC
        \uBE60\uC838\uB098\uAC00\uC57C\uACA0\uB2E4\uACE0 \uB2E4\uC9D0\uD569\uB2C8\uB2E4.\",,,\nT_AFTER_BATTLE,BRANCH,\"\uB5A0\uB09C\uB2E4\n\",END,,\n"
      PathID: 
  - id: ACT1_DEVIL_DOLL
    nameKO: "\uADC0\uC2E0\uB4E4\uB9B0 \uC778\uD615"
    type: 0
    imageName: "\uADC0\uC2E0 \uB4E4\uB9B0 \uC778\uD615"
    textPath: 
    order: 3
    isEssential: 0
    sourceCsvFile: {fileID: 0}
    encounterContext:
      csvRawData: "Page_ID,Type,Text_Content,Next_Page_ID,Call_Function,Constraint,\nP1,DESC,\"\uC5B4\uB450\uC6B4
        \uBCF5\uB3C4\uC758 \uB05D\uC5D0, \uBE5B\uB098\uB294 \uB208\uB3D9\uC790\uB97C
        \uAC00\uC9C4 \uC778\uD615\uC774 \uD558\uB098 \uBCF4\uC785\uB2C8\uB2E4. \n\n\uC778\uD615\uC740
        \uB618\uB9DD\uB618\uB9DD\uD55C \uB208\uB3D9\uC790\uC640 \uC624\uB611\uD55C
        \uCF54, \uCC30\uB791\uC774\uB294 \uBA38\uB9BF\uACB0\uC744 \uAC00\uC9C0\uACE0
        \uC788\uC2B5\uB2C8\uB2E4. \uADF8\uC57C\uB9D0\uB85C \uC544\uC774\uB4E4\uC774
        \uC88B\uC544\uD560 \uC218\uBC16\uC5D0 \uC5C6\uB294 \uADF8\uB7F0 \uC678\uBAA8\uC785\uB2C8\uB2E4.
        \uB2F9\uC2E0\uC740 \uC7A0\uAE50 \uC800 \uC778\uD615\uC744 \uC8FC\uC6CC\uAC08\uAE4C
        \uACE0\uBBFC\uD558\uC9C0\uB9CC \uADF8 \uACE0\uBBFC\uC740 \uAE38\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4.\n\n\uC778\uD615\uC774
        \uD55C \uC190\uC5D0 \uCE7C\uC744 \uB4E4\uACE0 \uB2F9\uC2E0\uC5D0\uAC8C \uB364\uBCBC\uB4E4\uC5C8\uAE30
        \uB54C\uBB38\uC774\uC8E0.\",,,\nP1,BRANCH,\"\uC778\uD615\uACFC \uC2F8\uC6B4\uB2E4.  
        (\uC804\uD22C)\n\",P_AFTER_BATTLE,StartBattle(DevilDoll),\nP_AFTER_BATTLE,DESC,\"\uB2F9\uC2E0\uC740
        \uC778\uD615\uC744 \uBB34\uC0AC\uD788 \uC81C\uC555\uD588\uC2B5\uB2C8\uB2E4.
        \uC628\uC21C\uD574\uC9C4 \uC778\uD615\uC744 \uBCF4\uB2C8, \uB2E4\uC2DC \uC8FC\uC6CC\uAC00\uACE0
        \uC2F6\uB2E4\uB294 \uC0DD\uAC01\uC774 \uBD88\uC465 \uB4DC\uB294\uAD70\uC694.\n\n\"\"\uB098\uB294
        \uCD94\uCC9C\uD558\uC9C0 \uC54A\uC544.\"\"\n\n\uC606\uC5D0\uC11C \uC9C0\uC9C0\uAC00
        \uD55C \uB9C8\uB514 \uD558\uC9C0\uB9CC, \uACB0\uAD6D \uC120\uD0DD\uC740 \uB2F9\uC2E0\uC5D0\uAC8C
        \uB2EC\uB838\uC2B5\uB2C8\uB2E4! \",,,\nP_AFTER_BATTLE,BRANCH,\uC90D\uB294\uB2E4.  
        (\uB8F0\uB81B \uD310\uC815: \uD589\uC6B4 >3),R,\"StartRoullete(Luck, 3, upper,P2_S,P2_GS,P2_F)
        \",\nP_AFTER_BATTLE,BRANCH,\"\uC90D\uC9C0 \uC54A\uB294\uB2E4.\n\n\n\n\",P3,,\nP3,DESC,\"\"\"\uADF8\uB798,
        \uC798 \uC0DD\uAC01\uD588\uC5B4. \uC800\uB7F0 \uBB3C\uAC74\uC740 \uCD5C\uB300\uD55C
        \uBA40\uB9AC \uD558\uB294 \uAC8C \uC0C1\uCC45\uC774\uB77C\uAD6C.\"\"\n\n\uB2F9\uC2E0\uC740
        \uC778\uD615\uC744 \uB4A4\uB85C \uB450\uACE0 \uB2E4\uC2DC \uAE38\uC744 \uB5A0\uB0A9\uB2C8\uB2E4.\",,,\nP3,BRANCH,\uB5A0\uB09C\uB2E4,END,,\nP2_S,DESC,\"\uB2E4\uD589\uD788
        \uC778\uD615\uC774 \uB2E4\uC2DC \uC0B4\uC544\uB098 \uB2F9\uC2E0\uC5D0\uAC8C
        \uCE7C\uC744 \uD718\uB450\uB974\uB294 \uC77C\uC740 \uC5C6\uC5C8\uC2B5\uB2C8\uB2E4.
        \n\n\uB2F9\uC2E0\uC740 \uC778\uD615\uC744 \uC798 \uCC59\uACA8\uB4E4\uACE0\uB294
        \uAE38\uC744 \uB5A0\uB0A9\uB2C8\uB2E4. \",,,\nP2_S,BRANCH,\uB5A0\uB09C\uB2E4,END,GetObjet(VoodooDoll),\nP2_GS,DESC,\"\uB2E4\uD589\uD788
        \uC778\uD615\uC774 \uB2E4\uC2DC \uC0B4\uC544\uB098 \uB2F9\uC2E0\uC5D0\uAC8C
        \uCE7C\uC744 \uD718\uB450\uB974\uB294 \uC77C\uC740 \uC5C6\uC5C8\uC2B5\uB2C8\uB2E4.
        \n\uAC8C\uB2E4\uAC00 \uC778\uD615 \uADFC\uCC98\uC5D0 \uC8FC\uC6B8\uB9CC\uD55C
        \uAC83\uB4E4\uC774 \uB354 \uC788\uAD70\uC694!\n\n\uB2F9\uC2E0\uC740 \uC778\uD615\uC744
        \uC798 \uCC59\uACA8\uB4E4\uACE0\uB294 \uAE38\uC744 \uB5A0\uB0A9\uB2C8\uB2E4.
        \",,,\nP2_GS,BRANCH,\uB5A0\uB09C\uB2E4,END,\"GetObjet(VoodooDoll),\nGetDebris(1)\",\nP2_F,DESC,\"\uB2F9\uC2E0\uC774
        \uC778\uD615\uC744 \uC8FC\uC6B0\uB7EC \uB2E4\uAC00\uAC00\uB294 \uADF8 \uC21C\uAC04!
        \uC778\uD615\uC774 \uBC8C\uB5A1 \uC77C\uC5B4\uB098 \uB2F9\uC2E0\uC744 \uACF5\uACA9\uD55C
        \uD6C4 \uB3C4\uB9DD\uAC11\uB2C8\uB2E4.\n\n\uD06C\uAC8C \uB2E4\uCE58\uC9C0\uB294
        \uC54A\uC558\uC9C0\uB9CC \uD53C\uAC00 \uC870\uAE08 \uB098\uB294\uAD70\uC694.\n\n\"\"\uADF8\uB7EC\uB2C8\uAE4C
        \uB0B4\uAC00 \uB9D0\uD588\uC796\uC544\u2026\"\"\n\n\uC9C0\uC9C0\uB294 \uB2F9\uC2E0\uC758
        \uC18D\uB3C4 \uBAA8\uB974\uACE0 \uC584\uBC09\uAC8C\uB3C4 \uD540\uC794\uC744
        \uC90D\uB2C8\uB2E4.\n\n\uB2F9\uC2E0\uC740 \uBC84\uB824\uC9C4 \uBB3C\uAC74\uC744
        \uD568\uBD80\uB85C \uC90D\uC9C0 \uB9D0\uC544\uC57C\uACA0\uB2E4\uB294 \uAD50\uD6C8\uC744
        \uC5BB\uACE0 \uAE38\uC744 \uB5A0\uB0A9\uB2C8\uB2E4. \",,,\nP2_F,BRANCH,\uB5A0\uB09C\uB2E4,END,\"LoseHP(5,
        ab)\",\n"
