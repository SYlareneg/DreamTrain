    encounterContext:
      csvRawData: "Page_ID,Type,Text_Content,Next_Page_ID,Call_Function,Constraint,\nP1,DESC,\"\uB2F9\uC2E0\uC740
        \uBE59\uAE00\uBE59\uAE00 \uB3C4\uB294 \uCC3B\uC794\uB4E4\uC5D0 \uC549\uC544
        \uC7A0\uAE50 \uC26C\uC5C8\uB2E4\uAC00\uAE30\uB85C \uACB0\uC815\uD569\uB2C8\uB2E4.
        \n\n\uADF8\uB7F0\uB370 \uC5B4\uB290\uC0CC\uAC00 \uB2F9\uC2E0 \uC55E\uC5D0
        \uC218\uC0C1\uD55C \uC0AC\uB78C\uC774 \uC790\uC5F0\uC2A4\uB7FD\uAC8C \uC549\uC544
        \uC788\uC2B5\uB2C8\uB2E4! \n\n\"\"\uB2F9\uC2E0\uC740 \uC6C3\uACE0 \uC788\uC9C0
        \uC54A\uB124\uC694.\"\"\n\n\uADF8\uB294 \uB73B \uBAA8\uB97C \uC774\uC57C\uAE30\uB97C
        \uC2DC\uC791\uD569\uB2C8\uB2E4.\n\n\"\"\uC774 \uB180\uC774\uACF5\uC6D0\uC5D0\uC11C\uB294
        \uBAA8\uB450 \uC6C3\uC744 \uC218\uBC16\uC5D0 \uC5C6\uB294 \uAC83 \uAC19\uC544\uC694.
        \uADF8\uB798\uC11C \uC544\uBB34\uB3C4 \uC6C3\uC744 \uC218 \uC5C6\uB294 \uAC70\uC608\uC694.
        \uC815\uB9D0 \uC2AC\uD508 \uC77C\uC774\uC8E0.\"\"\",,,\nP1,BRANCH,\uB2E4\uC74C,P2,,\nP2,DESC,\"\"\"\uC6D0\uD55C\uB2E4\uBA74
        \uB2F9\uC2E0\uB3C4 \uC6C3\uAC8C \uB9CC\uB4E4\uC5B4\uB4DC\uB9B4 \uC218 \uC788\uC5B4\uC694.
        \uB2F9\uC2E0\uC774 \uC6D0\uD55C\uB2E4\uBA74\uC694. \uADF8\uB7FC \uB2F9\uC2E0\uB3C4
        \uC5EC\uAE30\uC11C \uC601\uC6D0\uD788 \uC0B4\uC544\uAC08 \uC218 \uC788\uC744
        \uAC70\uC608\uC694.\"\"\n\n\uADF8\uB294 \uB2F9\uC2E0\uC758 \uB208\uC744 \uBC14\uB77C\uBCF4\uBA70
        \uB9D0\uD569\uB2C8\uB2E4.\n\n\"\"\uADF8\uB7EC\uAE30\uB97C \uC6D0\uD55C\uB2E4\uBA74,
        \uC9C0\uAE08 \uC800\uB97C \uBCF4\uBA70 \uC6C3\uC5B4\uC8FC\uC138\uC694.\"\"\n\n\",,,\nP2,BRANCH,\uC6C3\uC74C\uC744
        \uC9D3\uB294\uB2E4. ,P_SMILE,GetObjet(PermanentSmile),\nP2,BRANCH,\uC6C3\uC9C0
        \uC54A\uB294\uB2E4. ,P_REJECTION,\"UpStatus(Wisdom, 1)\",\nP_SMILE,DESC,\"\uB2F9\uC2E0\uC758
        \uB0B4\uBA74\uC5D0\uC11C \uBB34\uC5B8\uAC00 \uC0AC\uB77C\uC9C0\uB294 \uAC83
        \uAC19\uC740 \uB290\uB08C\uC774 \uB4E4\uC9C0\uB9CC, \uC815\uD655\uD788 \uBB34\uC2A8
        \uC77C\uC774 \uC77C\uC5B4\uB098\uACE0 \uC788\uB294 \uAC83\uC778\uC9C0\uB294
        \uBAA8\uB974\uACA0\uC2B5\uB2C8\uB2E4.\n\n\uB2E4\uB9CC \uD655\uC2E4\uD55C
        \uAC83\uC774 \uD55C \uAC00\uC9C0 \uC788\uAD70\uC694.\n\n\"\"\uC9C0\uAE08
        \uC5B4\uB5A4 \uAE30\uBD84\uC774 \uB4DC\uC2DC\uB098\uC694?\"\"\n\n\uB2F9\uC2E0\uC740
        \uC5B4\uB290 \uB54C\uBCF4\uB2E4\uB3C4 \uD06C\uAC8C \uD65C\uC9DD \uC6C3\uC74C\uC744
        \uC9C0\uC744 \uC218 \uC788\uAC8C \uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uC6C3\uC74C\uC758
        \uC774\uC720\uB294 \uBAA8\uB974\uACA0\uC9C0\uB9CC\uC694.\",,,\nP_SMILE,BRANCH,\uC6C3\uC74C\uC744
        \uC9C0\uC740 \uCC44 \uB5A0\uB09C\uB2E4,END,,\nP_REJECTION,DESC,\"\"\"\uADF8\uB807\uAD70\uC694.
        \uC5ED\uC2DC \uB2F9\uC2E0\uC740 \uC800\uC640 \uAC19\uC774 \uB2E4\uB978 \uBCC4\uC5D0\uC11C
        \uC624\uC2E0 \uBD84\uC774\uC600\uC5B4\uC694.\"\"\n\n\uADF8\uB294 \uB2F9\uC2E0\uC5D0\uAC8C
        \uC21C\uC218\uD55C \uC6C3\uC74C\uC744 \uC9C0\uC5B4 \uBCF4\uC774\uACE0\uB294,
        \uC870\uC6A9\uD788 \uC790\uB9AC\uB97C \uB5A0\uB0A9\uB2C8\uB2E4.\n\n\uB2F9\uC2E0\uC758
        \uBA38\uB9BF\uC18D\uC5D0\uB294 \uADF8\uC758 \uD2F0\uC5C6\uC774 \uB9D1\uC558\uB358
        \uC6C3\uC74C\uC774 \uACC4\uC18D\uD574\uC11C \uB9F4\uB3D5\uB2C8\uB2E4.\",,,\nP_REJECTION,BRANCH,\uB5A0\uB09C\uB2E4,END,,\n,,,,,\n,,,,,\n"
