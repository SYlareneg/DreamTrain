    encounterContext:
      csvRawData: "Page_ID,Type,Text_Content,Next_Page_ID,Call_Function,Constraint,\nP1,DESC,\"\uD76C\uBBF8\uD55C
        \uAF43\uD5A5\uAE30\uB97C \uB530\uB77C\uAC04 \uACF3\uC5D0\uB294, \uC774\uBBF8
        \uC2DC\uB4E4\uC5B4 \uB9D0\uB77C \uC8FD\uAE30 \uC9C1\uC804\uC758 \uAF43\uC774
        \uD558\uB098 \uC788\uC5C8\uC2B5\uB2C8\uB2E4. \uB2F9\uC2E0\uC740 \uADF8 \uAF43\uC5D0
        \uBB3C\uC744 \uC8FC\uACE0 \uC2F6\uB2E4\uB294 \uC0DD\uAC01\uC774 \uB4ED\uB2C8\uB2E4.\",,,\nP1,BRANCH,\uB208\uBB3C\uC744
        \uD758\uB824\uC900\uB2E4,P_TEAR,,\nP1,BRANCH,\"\uD53C\uB97C \uD758\uB824\uC900\uB2E4\n\",P_BLOOD,\"LoseHP(5,
        ab)\",\nP1,BRANCH,\uC640\uC778\uC744 \uD55C \uBC29\uC6B8 \uB5A8\uC5B4\uB728\uB9B0\uB2E4,P_WINE,,HasObjet(WineDrop)\nP_TEAR,DESC,\"\uAF43\uC5D0
        \uB2F9\uC2E0\uC758 \uB208\uBB3C\uC774 \uB2FF\uC790, \uAF43\uC774 \uC21C\uC2DD\uAC04\uC5D0
        \uD65C\uC9DD \uD53C\uC5B4\uB0A9\uB2C8\uB2E4. \uB9C8\uBC95 \uAC19\uC740 \uC77C\uC774\uAD70\uC694!\n\uADF8
        \uAF43\uC744 \uBC14\uB77C\uBCF4\uACE0 \uC788\uC73C\uB2C8 \uB2F9\uC2E0\uC758
        \uB9C8\uC74C\uC774 \uC870\uAE08\uC740 \uCE58\uC720\uB418\uB294 \uAC83 \uAC19\uC2B5\uB2C8\uB2E4.\",,,\nP_TEAR,BRANCH,\uB2E4\uC2DC
        \uAE38\uC744 \uB5A0\uB09C\uB2E4,END,Heal(10),\nP_BLOOD,DESC,\"\uAF43\uC5D0
        \uB2F9\uC2E0\uC758 \uD53C\uAC00 \uB2FF\uC790, \uAF43\uC78E\uC774 \uBD89\uAC8C
        \uBB3C\uB4E4\uB354\uB2C8 \uC21C\uC2DD\uAC04\uC5D0 \uB9D0\uB77C \uC8FD\uC5B4\uBC84\uB9BD\uB2C8\uB2E4.
        \uC2AC\uD508 \uC77C\uC774\uAD70\uC694.\n\n\uB2F9\uC2E0\uC740 \uAF43\uC78E\uC744
        \uD558\uB098 \uC8FC\uC6CC \uCC59\uAE30\uACE0\uB294 \uB2E4\uC2DC \uAE38\uC744
        \uB5A0\uB0A9\uB2C8\uB2E4.\",,,\nP_BLOOD,BRANCH,\uB5A0\uB09C\uB2E4,END,GetObjet(BloodyFlower),\nP_WINE,DESC,\"\uB2F9\uC2E0\uC740
        \uC640\uC778\uC794\uC5D0\uAC8C\uC11C \uC5BB\uC5C8\uB358 \uC640\uC778\uC744
        \uD55C \uBC29\uC6B8 \uB5A8\uC5B4\uB728\uB9BD\uB2C8\uB2E4. \uC640\uC778\uC774
        \uAF43\uC5D0 \uB2FF\uC790 \uAF43\uC774 \uC21C\uC2DD\uAC04\uC5D0 \uD53C\uC5B4\uB0A9\uB2C8\uB2E4.
        \uB9C8\uBC95 \uAC19\uC740 \uC77C\uC774\uAD70\uC694! \n\uAC8C\uB2E4\uAC00
        \uAF43\uC5D0\uC11C \uC640\uC778 \uD5A5\uC774 \uB098\uB294 \uAC83 \uAC19\uC2B5\uB2C8\uB2E4.
        \uADF8 \uD5A5\uC744 \uB9E1\uB2E4\uBCF4\uB2C8 \uB2F9\uC2E0\uC740 \uC870\uAE08
        \uC6A9\uAC10\uD574\uC9C0\uB294 \uAE30\uBD84\uC774 \uB4ED\uB2C8\uB2E4.\",,,\nP_WINE,BRANCH,\uB2E4\uC2DC
        \uAE38\uC744 \uB5A0\uB09C\uB2E4,END,\"UpStatus(Courage,2),DownStatus(Wisdom,1)\",\n,,,,,\n"
