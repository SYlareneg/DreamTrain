  - id: ACT1_BAT_ATTACK
    nameKO: "\uBC15\uC950\uC758 \uC2B5\uACA9"
    type: 0
    imageName: 
    textPath: 
    order: 1
    isEssential: 0
    sourceCsvFile: {fileID: 0}
    encounterContext:
      csvRawData: "Page_ID,Type,Text_Content,Next_Page_ID,Call_Function,Constraint,\nP1,DESC,\"\uC5B4\uB518\uAC00\uC5D0\uC11C
        \uC2EC\uC0C1\uCE58 \uC54A\uC740 \uC18C\uB9AC\uAC00 \uB4E4\uB824\uC635\uB2C8\uB2E4.
        \uC774\uB7F0, \uBC15\uC950\uAD70\uC694! \n\uB2F9\uC2E0\uACFC \uC9C0\uC9C0\uB97C
        \uD569\uD55C \uAC83\uBCF4\uB2E4\uB3C4 \uB354 \uD070 \uB369\uCE58\uB97C \uAC00\uC9C4
        \uAC70\uB300 \uBC15\uC950\uAC00 \uB2F9\uC2E0\uC744 \uC9C0\uAE0B\uC774 \uC751\uC2DC\uD569\uB2C8\uB2E4.
        \n\",,,\nP1,BRANCH,\uBA3C\uC800 \uACF5\uACA9\uD55C\uB2E4.   (\uC804\uD22C),P_AFTER_BATTLE,StartBattle(Bat),DEFAULT\nP1,BRANCH,\uC870\uC6A9\uD788
        \uC9C0\uB098\uAC04\uB2E4.,P_VAMP,,HasDream(Vampire)\nP_AFTER_BATTLE,DESC,\"\uC5B4\uB460
        \uC18D\uC5D0\uC11C\uC758 \uC0AC\uD22C \uB05D\uC5D0 \uB2F9\uC2E0\uC740 \uBC15\uC950\uB97C
        \uB5BC\uC5B4\uB0B4\uB294 \uB370 \uC131\uACF5\uD569\uB2C8\uB2E4! \uBC15\uC950\uB294
        \uB2F9\uC2E0\uC744 \uD55C \uBC88 \uB178\uB824\uBCF4\uACE0\uB294 \uC870\uC6A9\uD788
        \uC790\uB9AC\uB97C \uB5A0\uB0A9\uB2C8\uB2E4. \n\n\uBB34\uCC99\uC774\uB098
        \uAE30\uBD84 \uB098\uC05C \uC804\uD22C\uC600\uC2B5\uB2C8\uB2E4...\n\",,,DEFAULT\nP_AFTER_BATTLE,BRANCH,\uC790\uB9AC\uB97C
        \uB5A0\uB09C\uB2E4,END,,DEFAULT\nP_VAMP,DESC,\"\uBC15\uC950\uB294 \uB2F9\uC2E0\uC5D0\uAC8C
        \uC11C\uC11C\uD788 \uB2E4\uAC00\uC624\uB354\uB2C8\u2026\uB180\uB78D\uAC8C\uB3C4
        \uB2F9\uC2E0\uC5D0\uAC8C \uC791\uC740 \uC120\uBB3C\uC744 \uC8FC\uACE0\uB294
        \uC720\uC720\uD788 \uC790\uB9AC\uB97C \uB5A0\uB0A9\uB2C8\uB2E4! \uBC15\uC950\uC5D0\uAC8C
        \uC120\uBB3C\uC744 \uBC1B\uB2E4\uB2C8 \uC2E0\uAE30\uD55C \uACBD\uD5D8\uC774\uAD70\uC694.\n\n\uB2F9\uC2E0\uC740
        \uBC15\uC950\uC758 \uC120\uBB3C\uC744 \uC18C\uC911\uD788 \uC8FC\uC6CC\uB4E4\uACE0\uB294
        \uB2E4\uC74C \uC7A5\uC18C\uB85C \uD5A5\uD569\uB2C8\uB2E4.\n\",,GetObjet(BatWings),\nP_VAMP,BRANCH,\uB5A0\uB09C\uB2E4,END,,DEFAULT\n,,,,,\n,,,,,\n,,,,,\n,,,,,\n"
      PathID: 
  - id: ACT1_VAMP_INVITATION
    nameKO: "\uBC40\uD30C\uC774\uC5B4\uC758 \uCD08\uB300"
    type: 1
    imageName: 
    textPath: 
    order: 4
    isEssential: 0
    sourceCsvFile: {fileID: 0}
    encounterContext:
      csvRawData: "Page_ID,Type,Text_Content,Next_Page_ID,Call_Function,Constraint,\nP1,DESC,\"\uB69C\uBC85\uB69C\uBC85
        \uAC78\uC5B4\uAC00\uB294 \uB2F9\uC2E0\uC758 \uBC1C\uC5D0 \uBB34\uC5B8\uAC00
        \uBC1F\uD799\uB2C8\uB2E4. \uD3B8\uC9C0\uC9C0 \uC548\uC5D0\uB294 \uB2F9\uC2E0\uC744
        \uB9CC\uCC2C \uCC28\uB9AC\uC5D0 \uCD08\uB300\uD558\uACA0\uB2E4\uB294 \uB0B4\uC6A9\uC774
        \uC4F0\uC5EC \uC788\uAD70\uC694! \uC774 \uD3B8\uC9C0\uB294 \uB204\uAD70\uAC00\uB97C
        \uCD08\uB300\uD558\uAE30 \uC704\uD55C \uCD08\uB300\uC7A5\uC778 \uAC83 \uAC19\uC2B5\uB2C8\uB2E4.\n\",,,\nP1,BRANCH,\uCD08\uB300\uC5D0
        \uC751\uD55C\uB2E4.,P_INVTATION,,DEFAULT\nP1,BRANCH,\uCD08\uB300\uB97C \uBB34\uC2DC\uD55C\uB2E4.,P_EXIT,,HasDream(Vampire)\nP_INVTATION,DESC,\"\uCD08\uB300\uC7A5\uC758
        \uC57D\uB3C4\uB97C \uB530\uB77C \uCC3E\uC544\uAC04 \uACF3\uC5D0\uB294, \uB180\uB78D\uAC8C\uB3C4
        \uBC40\uD30C\uC774\uC5B4 \uD558\uB098\uAC00 \uC549\uC544 \uC788\uC2B5\uB2C8\uB2E4.
        \uC544\uC8FC \uC131\uB300\uD55C \uB9CC\uCC2C\uACFC \uD568\uAED8 \uB9D0\uC774\uC8E0.\n\"\"\uB9DB\uC788\uAC8C
        \uBA39\uB3C4\uB85D \uD574. \uB108\uB97C \uC704\uD574 \uC5F4\uC2EC\uD788 \uC900\uBE44\uD55C
        \uAC70\uB2C8\uAE4C.\"\"\n\n\uB2F9\uC2E0\uC740 \uC2DD\uD0C1\uC5D0 \uB193\uC778
        \uACE0\uAE30\uB97C \uD55C \uC810 \uC9D1\uC5B4\uBA39\uC2B5\uB2C8\uB2E4. \uC9C4\uBBF8\uB85C\uAD70\uC694!\n\n\"\"\uADC0\uC5EC\uC6B4
        \uC544\uC774\uC57C, \uB098\uB294 \uB124\uAC00 \uC5B8\uC820\uAC00 \uC5EC\uAE30\uC5D0
        \uC624\uAC8C \uB420 \uAC70\uB77C\uACE0 \uBBFF\uC5B4\uC654\uB2E8\uB2E4! \uB098\uC640
        \uD568\uAED8 \uC5EC\uAE30\uC11C \uD3C9\uC0DD \uD568\uAED8 \uD558\uC9C0 \uC54A\uACA0\uB2C8?
        \uB124\uAC00 \uC6D0\uD558\uB294 \uBAA8\uB4E0 \uAC83\uC744 \uB0B4\uAC00 \uC904
        \uC218 \uC788\uB2E8\uB2E4. \uB9DB\uC788\uB294 \uC74C\uC2DD\uB3C4, \uC608\uC05C
        \uC637\uB3C4, \uC7AC\uBC0C\uB294 \uCE5C\uAD6C\uB3C4 \uB9D0\uC774\uC57C.\"\"\n\n\n\",,,DEFAULT\nP_INVTATION,BRANCH,\uC601\uC6D0\uD788
        \uD568\uAED8 \uD558\uACA0\uB2E4\uACE0 \uB9D0\uD55C\uB2E4.,P_ACCEPT,,DEFAULT\nP_INVTATION,BRANCH,\uC81C\uC548\uC744
        \uAC70\uC808\uD55C\uB2E4.,P_REJECTION,,\nP_ACCEPT,DESC,\"\"\"\uADF8\uB7F4
        \uC218\uB294 \uC5C6\uC5B4. \uC6B0\uB9AC\uB294 \uBE68\uB9AC \uC774 \uB180\uC774\uACF5\uC6D0\uC744
        \uC9C0\uB098\uC11C \uAFC8\uC758 \uB05D\uAE4C\uC9C0 \uAC00\uC57C \uD55C\uB2E4\uACE0!\"\"\n\n\uC9C0\uC9C0\uAC00
        \uB2F9\uC2E0\uC744 \uB098\uBB34\uB77C\uB294 \uC18C\uB9AC\uC5D0, \uB2F9\uC2E0\uC740
        \uC815\uC2E0\uC774 \uBC88\uCA4D \uB4ED\uB2C8\uB2E4! \uD558\uB9C8\uD130\uBA74
        \uD3C9\uC0DD \uC720\uB839\uC758 \uC9D1\uC5D0 \uAC07\uD600 \uC0B4 \uBED4 \uD588\uAD70\uC694!\n\n\"\"\uBC84\uB987
        \uC5C6\uB294 \uACE0\uC591\uC774\uAC00 \uD55C \uB9C8\uB9AC \uC788\uC5C8\uAD6C\uB098.
        \uC544\uBB34\uB798\uB3C4 \uADF8 \uACE0\uC591\uC774\uC758 \uC785\uC744 \uCC22\uC5B4\uB193\uACE0
        \uB098\uC11C \uB2E4\uC2DC \uC6B0\uB9AC \uB458\uC774 \uC598\uAE30\uB97C \uD574\uBCF4\uBA74
        \uC88B\uACA0\uC5B4!\"\"\n\n\uBC40\uD30C\uC774\uC5B4\uC758 \uB208\uC774 \uBD89\uAC8C
        \uBB3C\uB4E4\uBA74\uC11C, \uC74C\uC0B0\uD55C \uAE30\uC6B4\uC774 \uBC29 \uAC00\uB4DD
        \uD37C\uC838 \uB098\uAC11\uB2C8\uB2E4. \n\uB2F9\uC2E0\uC740 \uC9C0\uC9C0\uC640
        \uD568\uAED8 \uB9C8\uC74C\uC744 \uB2E4\uC7A1\uACE0 \uC804\uD22C\uB97C \uC900\uBE44\uD569\uB2C8\uB2E4.\",,,DEFAULT\nP_ACCEPT,BRANCH,\uC804\uD22C\uB97C
        \uC900\uBE44\uD55C\uB2E4.   (\uC804\uD22C),P_AFTER_BATTLE,StartBattle(Vamp),\nP_REJECTION,DESC,\"\"\"\uC544\uC774\uC57C,
        \uC5B4\uC9F8\uC11C \uAC70\uC808\uD558\uB294 \uAC70\uB2C8? \uB124\uAC00 \uBC14\uB77C\uB294
        \uBAA8\uB4E0 \uAC83\uC774 \uB108\uC758 \uAC83\uC774 \uB420 \uD150\uB370.\"\"\n\uBC40\uD30C\uC774\uC5B4\uB294
        \uB2F9\uC2E0\uC744 \uC124\uB4DD\uD558\uB824 \uB178\uB825\uD558\uC9C0\uB9CC,
        \uB2F9\uC2E0\uC740 \uC7AC\uCC28 \uC81C\uC548\uC744 \uAC70\uC808\uD569\uB2C8\uB2E4.\n\n\"\"\uADF8\uB798.
        \uB108\uB3C4 \uB098\uB97C \uB0A8\uACA8\uB450\uACE0 \uB5A0\uB098\uACA0\uB2E4\uB294
        \uAC70\uB2C8? \uC544\uC544, \uC54C\uACA0\uB2E4. \uB124 \uC606\uC5D0 \uADF8
        \uACE0\uC591\uC774\uAC00 \uBB38\uC81C\uAD6C\uB098. \uADF8 \uACE0\uC591\uC774
        \uB54C\uBB38\uC5D0 \uB10C \uC678\uB85C\uC6C0\uC744 \uBAA8\uB974\uB294 \uAC70\uC57C.
        \uC544\uC774\uC57C, \uB108\uB3C4 \uB098\uC640 \uAC19\uC774 \uC678\uB85C\uC6CC\uC9C4\uB2E4\uBA74
        \uC6B0\uB9B0 \uC9C4\uC815\uD55C \uAC00\uC871\uC774 \uB420 \uC218 \uC788\uC744
        \uAC70\uB780\uB2E4.\"\"\n\n\uC2AC\uD514\uC5D0 \uC7A0\uAE34 \uBC40\uD30C\uC774\uC5B4\uC758
        \uB208\uC774 \uBD89\uAC8C \uBB3C\uB4E4\uACE0, \uC74C\uC0B0\uD55C \uAE30\uC6B4\uC774
        \uBC29 \uAC00\uB4DD \uD37C\uC838 \uB098\uAC11\uB2C8\uB2E4.\n\n\"\"\uC774\uBC88\uC5D0\uB294
        \uAF64 \uD798\uB4E0 \uC2F8\uC6C0\uC774 \uB420 \uC218\uB3C4 \uC788\uACA0\uC5B4.\"\"\n\n\uB2F9\uC2E0\uC740
        \uC9C0\uC9C0\uC640 \uD568\uAED8 \uB9C8\uC74C\uC744 \uB2E4\uC7A1\uACE0 \uC804\uD22C\uB97C
        \uC900\uBE44\uD569\uB2C8\uB2E4.\",,,\nP_REJECTION,BRANCH,\uBC40\uD30C\uC774\uC5B4\uC640
        \uC2F8\uC6B4\uB2E4.   (\uC804\uD22C),P_AFTER_BATTLE,StartBattle(Vamp),\nP_AFTER_BATTLE,DESC,\"\uD798\uC744
        \uB2E4 \uC4F4 \uBC40\uD30C\uC774\uC5B4\uB294 \uB9CE\uC774 \uC9C0\uCCD0 \uBCF4\uC785\uB2C8\uB2E4.
        \n\n\"\"\uBAA8\uB450\uAC00 \uC678\uB86D\uB2E4\uBA74 \uB098\uB3C4 \uB354 \uC774\uC0C1
        \uC678\uB86D\uC9C0 \uC54A\uC744\uD150\uB370...\"\"\n\n\uBC40\uD30C\uC774\uC5B4\uB294
        \uC758\uC2DD\uC744 \uC783\uACE0 \uC4F0\uB7EC\uC9C4 \uAC83 \uAC19\uC2B5\uB2C8\uB2E4.
        \uB2F9\uC2E0\uC740 \uADF8 \uD2C8\uC744 \uD0C0 \uC2E0\uC18D\uD558\uAC8C \uBC29\uC744
        \uBE60\uC838\uB098\uAC11\uB2C8\uB2E4. \uBD80\uC9C0\uB7F0\uD788 \uAC78\uC5B4\uC628
        \uB2F9\uC2E0\uC758 \uB208\uC5D0 \uC5B4\uB290\uC0C8 \uC774\uACF3\uC758 \uCD9C\uAD6C\uAC00
        \uBCF4\uC785\uB2C8\uB2E4!\",,,\nP_AFTER_BATTLE,BRANCH,\uC720\uB839\uC758
        \uC9D1\uC744 \uB098\uAC04\uB2E4,END,,\nP_EXIT,DESC,\"\uB2F9\uC2E0\uC740 \uC218\uC0C1\uD55C
        \uCD08\uB300\uC7A5\uC744 \uBB34\uC2DC\uD558\uAE30\uB85C \uACB0\uC815\uD569\uB2C8\uB2E4.
        \uC0AC\uC11C \uACE0\uC0DD\uC744 \uD560 \uD544\uC694\uB294 \uC5C6\uC8E0.\n\n\uBD80\uC9C0\uB7F0\uD788
        \uAC78\uC5B4\uC628 \uB2F9\uC2E0\uC740 \uC5B4\uB290\uC0C8 \uC774\uACF3\uC758
        \uCD9C\uAD6C\uC5D0 \uB3C4\uCC29\uD588\uC2B5\uB2C8\uB2E4!\n\",,,\nP_EXIT,BRANCH,\uC720\uB839\uC758
        \uC9D1\uC744 \uB098\uAC04\uB2E4,END,,\n"
      PathID: 
  - id: ACT1_SHEEP_IN_MAZE
    nameKO: "\uAE38\uC744 \uC783\uC740 \uC0C1\uC778"
    type: 4
    imageName: 
    textPath: 
    order: 0
    isEssential: 0
    sourceCsvFile: {fileID: 0}
    encounterContext:
      csvRawData: "Page_ID,Type,Text_Content,Next_Page_ID,Call_Function,Constraint\r\nP1,DESC,\"\"\"\uC774\uAC70
        \uC815\uB9D0 \uD070\uC77C\uC778\uAC78. \uC774\uB7F0 \uACF3\uC5D0\uC11C \uAE38\uC744
        \uC783\uAC8C \uB418\uB2E4\uB2C8.\"\"\r\n\r\n\uBCF4\uB530\uB9AC\uB97C \uC794\uB729
        \uB4F1\uC5D0 \uC774\uACE0 \uC788\uB294 \uC591 \uC0C1\uC778\uC774 \uBB38\uC81C\uC5D0
        \uBE60\uC9C4 \uAC83 \uAC19\uC2B5\uB2C8\uB2E4. \r\n\r\n\"\"\uBBF8\uB85C\uAC00
        \uB108\uBB34 \uBCF5\uC7A1\uD574\uC11C \uAE38\uC744 \uC783\uC5B4\uBC84\uB838\uC9C0
        \uBB50\uC57C. \uC544\uBB34\uB798\uB3C4 \uBBF8\uB85C\uAC00 \uC544\uB2C8\uB77C
        \uB2E4\uB978 \uACF3\uC73C\uB85C \uC9C0\uB098\uAC00\uB294 \uAC8C \uC88B\uACA0\uC5B4.
        \uC544\uC774\uC57C, \uD639\uC2DC \uB098\uAC00\uB294 \uAE38\uC744 \uC54C\uACE0
        \uC788\uB2C8?\"\"\",,,\r\nP1,BRANCH,\uC548\uB2E4   (\uC9C0\uD61C>3),R,\"StartRoullete(Wisdom,
        3, upper,P2_S,P2_GS,P2_F) \",\r\nP1,BRANCH,\uBAA8\uB978\uB2E4,P_MERCHANT,,\r\nP2_S,DESC,\"\uB2F9\uC2E0\uC740
        \uAE30\uC5B5\uC744 \uB354\uB4EC\uC5B4 \uC785\uAD6C \uBC29\uD5A5\uC774 \uC5B4\uB514\uC600\uB294\uC9C0\uB97C
        \uAE30\uC5B5\uD574\uB0C5\uB2C8\uB2E4. \r\n\r\n\"\"\uADF8\uB807\uAD6C\uB098.
        \uADF8 \uC815\uB3C4\uBA74 \uC5B4\uB5BB\uAC8C\uB4E0 \uCC3E\uC544\uAC08 \uC218
        \uC788\uACA0\uC5B4. \uACE0\uB9C8\uC6CC!\"\"\r\n\r\n\uC591 \uC0C1\uC778\uC740
        \uB2F9\uC2E0\uC5D0\uAC8C \uB2F5\uB840\uB97C \uCC59\uACA8\uC900 \uD6C4, \uBCF4\uB530\uB9AC\uB97C
        \uB4E4\uACE0 \uB2F9\uC2E0\uC774 \uC54C\uB824\uC900 \uBC29\uD5A5\uC73C\uB85C
        \uD5A5\uD569\uB2C8\uB2E4.\r\n\r\n\uB2F9\uC2E0\uB3C4 \uB2E4\uC2DC \uCD9C\uAD6C\uB97C
        \uCC3E\uC544\uB098\uC12D\uB2C8\uB2E4.  \r\n\",,,\r\nP2_S,BRANCH,\uB5A0\uB09C\uB2E4,END,GetDebris(1),\r\nP2_GS,DESC,\"\uB2F9\uC2E0\uC740
        \uB6F0\uC5B4\uB09C \uAE30\uC5B5\uB825\uC73C\uB85C \uC785\uAD6C \uBC29\uD5A5\uC774
        \uC5B4\uB514\uC600\uB294\uC9C0\uB97C \uC815\uD655\uD558\uAC8C \uC54C\uB824\uC8FC\uC5C8\uC2B5\uB2C8\uB2E4.
        \r\n\r\n\"\"\uADF8\uB807\uAD6C\uB098. \uC774 \uBC29\uD5A5\uC73C\uB85C \uAC00\uBA74
        \uD655\uC2E4\uD788 \uC785\uAD6C\uAC00 \uB098\uC624\uACA0\uC5B4!\"\"\r\n\r\n\uC591
        \uC0C1\uC778\uC740 \uB2F9\uC2E0\uC5D0\uAC8C \uD6C4\uD55C \uB2F5\uB840\uB97C
        \uCC59\uACA8\uC900 \uD6C4, \uBCF4\uB530\uB9AC\uB97C \uB4E4\uACE0 \uB2F9\uC2E0\uC774
        \uC54C\uB824\uC900 \uBC29\uD5A5\uC73C\uB85C \uD5A5\uD569\uB2C8\uB2E4.\r\n\r\n\uB2F9\uC2E0\uB3C4
        \uB2E4\uC2DC \uCD9C\uAD6C\uB97C \uCC3E\uC544\uB098\uC12D\uB2C8\uB2E4.  \r\n\",,,\r\nP2_GS,BRANCH,\uB5A0\uB09C\uB2E4,END,GetDebris(2),\r\nP2_F,DESC,\"\uB2F9\uC2E0\uC740
        \uC785\uAD6C\uAC00 \uC5B4\uB514\uC600\uB294\uC9C0 \uCD5C\uC120\uC744 \uB2E4\uD574
        \uAE30\uC5B5\uD574\uBCF4\uB824 \uD558\uC9C0\uB9CC, \uC548\uD0C0\uAE5D\uAC8C\uB3C4
        \uB2F9\uC2E0\uC758 \uBA38\uB9AC \uB610\uD55C \uBBF8\uB85C \uC18D\uC5D0\uC11C
        \uD63C\uB780\uC2A4\uB7FD\uAE30\uB9CC \uD569\uB2C8\uB2E4.\r\n\r\n\"\"\uC73C\uC74C!
        \uB108\uB3C4 \uAE38\uC744 \uC783\uC5C8\uAD6C\uB098!\"\"\r\n\r\n\uC591 \uC0C1\uC778\uC740
        \uD638\uD638 \uC6C3\uC74C\uC744 \uC9C0\uC740 \uB4A4, \uBCF4\uB530\uB9AC\uB97C
        \uB4E4\uACE0 \uCD9C\uAD6C\uB97C \uCC3E\uC544 \uB5A0\uB0A9\uB2C8\uB2E4.\r\n\r\n\uB2F9\uC2E0\uB3C4
        \uC815\uB9D0\uB85C \uAE38\uC744 \uC783\uAE30 \uC804\uC5D0 \uBE68\uB9AC \uCD9C\uAD6C\uB97C
        \uCC3E\uC544\uC57C\uACA0\uB2E4\uB294 \uC0DD\uAC01\uC774 \uB4ED\uB2C8\uB2E4.\r\n\",,,\r\nP2_F,BRANCH,\uB5A0\uB09C\uB2E4,END,\"DownStatus(Courage,1)\",\r\nP_MERCHANT,DESC,\"\"\"\uC5B4\uCA54
        \uC218 \uC5C6\uC9C0. \uADF8\uB7FC \uB9CC\uB09C \uAE40\uC5D0 \uB3C4\uC6C0\uC774
        \uB420 \uBB3C\uAC74\uC774\uB098 \uD55C \uBC88 \uACE8\uB77C\uBD10!\"\"\r\n\",,,\r\nP_MERCHANT,BRANCH,\"\uC0C1\uC810\uC744
        \uB458\uB7EC\uBCF8\uB2E4\r\n\r\n\",P_AFTER_MERCHANT,meetMerchant(),\r\nP_AFTER_MERCHANT,DESC,\"\"\"\uADF8\uB798,
        \uADF8\uB7FC \uB2E4\uC74C\uC5D0 \uB610 \uBCF4\uC790\uAD6C.\"\"\r\n\uC591\uC740
        \uB2F9\uC2E0\uC5D0\uAC8C \uC778\uC0AC\uB97C \uAC74\uB124\uACE0 \uAC08 \uAE38\uC744
        \uB5A0\uB0A9\uB2C8\uB2E4.\r\n\r\n\uB2F9\uC2E0\uB3C4 \uCD9C\uAD6C\uB97C \uCC3E\uC544
        \uB5A0\uB0A9\uB2C8\uB2E4.\r\n\",,,\r\nP_AFTER_MERCHANT,BRANCH,\uB5A0\uB09C\uB2E4,END,,\r\n,,,,,\r\n,,,,,\r\n"
