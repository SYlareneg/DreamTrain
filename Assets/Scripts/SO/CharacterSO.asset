        \uD68C\uC804\uC2DC\uD0A4\uACE0, \uB9C8\uC220\uC744 \uD3BC\uCCD0 \uBC29\uC5B4\uB3C4\uB97C
        {cardValues[1]} \uBD80\uC5EC\uD569\uB2C8\uB2E4. \uD50C\uB808\uC774\uC5B4\uC758
        \uD6A8\uACFC \uC874\uC5D0 \uB9C8\uC220 \uC0C1\uC790\uAC00 \uC5C6\uB2E4\uBA74
        \uB9C8\uC220\uC740 \uC2E4\uD328\uD569\uB2C8\uB2E4. "
      cardValues: 020000000c000000
      num: 2
    - name: "\uB9C8\uC220-\uC608\uC5B8"
      cost: 3
      type: 2
      element: 1
      dreamPieceNum: 1
      isVolatile: 0
      isVanish: 0
      isRemain: 0
      sprite: {fileID: 10907, guid: 0000000000000000f000000000000000, type: 0}
      text: "\uB2E4\uC74C \uD134\uC5D0 '\uC5D0\uC774\uC2A4' \uCE74\uB4DC\uB97C \uC0AC\uC6A9\uD558\uBA74
        \uCF54\uC2A4\uD2B8\uB97C \uC18C\uBAA8\uD558\uC9C0 \uC54A\uACE0, \uD589\uB3D9\uB825\uC744
        \uCD5C\uB300\uB85C \uD68C\uBCF5\uD569\uB2C8\uB2E4. \uC790\uC2E0\uC758 \uD6A8\uACFC
        \uC874\uC5D0 \uB9C8\uC220 \uC0C1\uC790\uAC00 \uC788\uB2E4\uBA74 \uC774 \uCE74\uB4DC\uC758
        \uC18C\uBAA8 \uCF54\uC2A4\uD2B8\uAC00 {cardValues[0]} \uAC10\uC18C\uD569\uB2C8\uB2E4."
