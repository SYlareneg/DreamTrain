  maxHealth: 20
  curHealth: 20
  personaPiece:
    name: "\uB9C8\uC220\uC0AC\uC758 \uAFC8"
    persona:
      type: 1
      sprite: {fileID: 1599388452501240626, guid: f2660930dd1408c43b1357f97f2fdf1e, type: 3}
      name: "\uCE74\uB4DC \uC228\uAE30\uAE30"
      text: "\uAC8C\uC784 \uC2DC\uC791 \uC2DC \uB371\uC5D0 \uC5D0\uC774\uC2A4 \uCE74\uB4DC\uB97C
        \uD55C \uC7A5 \uCD94\uAC00\uD569\uB2C8\uB2E4. \uC5D0\uC774\uC2A4 \uCE74\uB4DC\uB97C
        \uC0AC\uC6A9\uD558\uC5EC \uD2B8\uB9AC\uAC70\uD569\uB2C8\uB2E4. "
    shadow:
      type: 2
      sprite: {fileID: 1599388452501240626, guid: f2660930dd1408c43b1357f97f2fdf1e, type: 3}
      name: "\uB9C8\uC220 \uD574\uCCB4"
      text: "\uACF5\uACA9\uACFC \uC218\uBE44\uB97C \uC81C\uC678\uD558\uACE0 \uB8F0\uB81B\uC5D0
        \uBD80\uC5EC\uB41C \uBAA8\uB4E0 \uD6A8\uACFC\uB97C \uC81C\uAC70\uD569\uB2C8\uB2E4.
        \uC81C\uAC70\uD55C \uBD80\uC5EC \uD6A8\uACFC \uAC1C\uC218 x 7\uC758 \uB370\uBBF8\uC9C0\uB97C
        \uC90D\uB2C8\uB2E4."
    cards:
    - name: "\uB9C8\uC220 \uC0C1\uC790"
      cost: 1
      type: 1
      element: 0
      dreamPieceNum: 1
      isVolatile: 0
      isVanish: 0
      isRemain: 0
      sprite: {fileID: 10907, guid: 0000000000000000f000000000000000, type: 0}
      text: "\uC790\uC2E0\uC758 \uD6A8\uACFC \uC874\uC5D0 \uC704\uCE58\uD55C \uB8F0\uB81B\uC5D0
        '\uB9C8\uC220\uC0C1\uC790'\uB97C \uBD80\uC5EC\uD569\uB2C8\uB2E4"
      cardValues: 
      num: 2
    - name: "\uB9C8\uC220-\uBE44\uB458\uAE30"
      cost: 1
      type: 2
      element: 0
      dreamPieceNum: 1
      isVolatile: 0
      isVanish: 0
      isRemain: 0
      sprite: {fileID: 10907, guid: 0000000000000000f000000000000000, type: 0}
      text: "{cardValues[0]}\uB370\uBBF8\uC9C0\uB97C \uC8FC\uACE0, \uB9C8\uC220\uC744
        \uD3BC\uCCD0 \uC801\uC758 \uB2E4\uC74C \uD134 \uCCAB\uBC88\uC9F8 \uD589\uB3D9\uC744
        \uBC29\uD574\uD569\uB2C8\uB2E4. \uC801\uC758 \uD6A8\uACFC \uC874\uC5D0 \uB9C8
        \uC220 \uC0C1\uC790\uAC00 \uC5C6\uB2E4\uBA74 \uB9C8\uC220\uC740 \uC2E4\uD328\uD569\uB2C8\uB2E4."
      cardValues: 01000000
      num: 2
    - name: "\uB9C8\uC220-\uCE74\uB4DC"
      cost: 1
      type: 0
      element: 0
      dreamPieceNum: 1
      isVolatile: 0
      isVanish: 0
      isRemain: 0
      sprite: {fileID: 10907, guid: 0000000000000000f000000000000000, type: 0}
      text: "\uB8F0\uB81B\uC744 \uC2DC\uACC4\uBC29\uD5A5\uC73C\uB85C {cardValues[0]}\uCE78
        \uD68C\uC804\uC2DC\uD0A4\uACE0, \uB9C8\uC220\uC744 \uD3BC\uCCD0 \uD328\uC758
        \uCE74\uB4DC \uD55C \uC7A5\uC744 \uC120\uD0DD\uD574 \uBCF5\uC81C\uD569\uB2C8\uB2E4.
        \uD50C\uB808\uC774\uC5B4\uC758 \uD6A8\uACFC \uC874\uC5D0 \uB9C8\uC220 \uC0C1\uC790\uAC00
        \uC5C6\uB2E4\uBA74 \uB9C8\uC220\uC740 \uC2E4\uD328\uD569\uB2C8\uB2E4."
      cardValues: 01000000
      num: 2
    - name: "\uB9C8\uC220-\uC808\uB2E8"
      cost: 2
      type: 2
      element: 0
      dreamPieceNum: 1
      isVolatile: 0
      isVanish: 0
      isRemain: 0
      sprite: {fileID: 10907, guid: 0000000000000000f000000000000000, type: 0}
      text: "\uC801\uC5D0\uAC8C {cardValues[0]} \uB370\uBBF8\uC9C0\uB97C \uC8FC\uACE0,
        \uB9C8\uC220\uC744 \uD3BC\uCCD0 \uBC29\uC5B4\uB3C4\uB97C \uBAA8\uB450 \uD30C\uAD34\uD569\uB2C8\uB2E4.
        \uC801\uC758 \uD6A8\uACFC \uC874\uC5D0 \uB9C8\uC220 \uC0C1 \uC790\uAC00 \uC5C6\uB2E4\uBA74
        \uB9C8\uC220\uC740 \uC2E4\uD328\uD569\uB2C8\uB2E4."
      cardValues: 02000000
      num: 2
    - name: "\uB9C8\uC220-\uC21C\uAC04\uC774\uB3D9"
      cost: 2
      type: 0
      element: 0
      dreamPieceNum: 1
      isVolatile: 0
      isVanish: 0
